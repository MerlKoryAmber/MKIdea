<Window x:Class="AdServerGroups.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD Server Groups"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="200"/>
      <RowDefinition Height="6"/>
      <RowDefinition x:Name="LogRow" Height="140" MinHeight="72" MaxHeight="520"/>
    </Grid.RowDefinitions>

    <!-- Hero chrome -->
    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="22,18,22,16">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" Direction="270" Color="#102033"/>
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="AD Server Groups" Style="{StaticResource BrandTitle}"/>
          </StackPanel>
          <TextBlock x:Name="BrandSubText"
                     Text="Серверы из OU → группы по шаблону → локальные Administrators"
                     Style="{StaticResource BrandSub}" Margin="20,0,0,10"/>
          <Border Background="#221A9B8E" BorderBrush="#552DD4BF" BorderThickness="1" CornerRadius="8"
                  Padding="12,8" Margin="20,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Контур" Foreground="#8EB8B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <RadioButton x:Name="ModeLocalRadio" GroupName="WorkMode" Content="Local Admins"
                           Foreground="#E8F4F2" FontWeight="SemiBold" Margin="0,0,14,0"
                           IsChecked="True" Checked="WorkMode_Changed"
                           ToolTip="Источник → Группы → Локальные админы → Выполнение"/>
              <RadioButton x:Name="ModeSqlRadio" GroupName="WorkMode" Content="SQL sysadmin"
                           Foreground="#E8F4F2" FontWeight="SemiBold"
                           Checked="WorkMode_Changed"
                           ToolTip="Источник → Группы (SQL-шаблон) → SQL. Нужен Providers\"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource Chip}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#3DDC97" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusDomainText" Style="{StaticResource ChipText}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}">
              <TextBlock x:Name="StatusUserText" Style="{StaticResource ChipText}"/>
            </Border>
            <Border x:Name="AuthBadge" Style="{StaticResource Chip}" Background="#332DD4BF" BorderBrush="#662DD4BF">
              <TextBlock x:Name="AuthModeText" Style="{StaticResource ChipText}" Foreground="#A8F0E4" FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource Chip}">
              <TextBlock x:Name="StatusContainerText" Style="{StaticResource ChipText}" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Content="Переподключить" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Connect_Click"
                  ToolTip="Проверить сессию AD / ввести пароль, если SSO не сработал. Список и галки не сбрасывает."/>
          <Button Content="Настройки" Style="{StaticResource BtnGhost}" Click="Settings_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Row="1">
      <Rectangle Fill="{StaticResource ShellGradient}"/>
      <Rectangle Fill="{StaticResource GridPatternBrush}"/>
      <TabControl x:Name="MainTabs" Margin="18">

        <TabItem x:Name="SourceTab" Header="1 · Источник">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                         Text="Только компьютеры с «Windows Server» в атрибуте ОС"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Обновить список" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="RefreshComputers_Click"/>
                <Button Content="К группам →" Style="{StaticResource BtnPrimary}" Click="GoGroups_Click"/>
              </StackPanel>
            </DockPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.35*" MinWidth="280"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Surface}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                    <TextBlock Text="Контейнеры AD" Style="{StaticResource SectionTitle}"/>
                  </Border>
                  <TreeView x:Name="OuTree" SelectedItemChanged="OuTree_SelectedItemChanged"/>
                </DockPanel>
              </Border>

              <GridSplitter Grid.Column="1"
                            Width="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ResizeDirection="Columns"
                            ResizeBehavior="PreviousAndNext"
                            Background="#C5D0DB"
                            ShowsPreview="True"
                            Cursor="SizeWE"
                            ToolTip="Ширина дерева OU / списка компьютеров"/>

              <Border Grid.Column="2" Style="{StaticResource Surface}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                    <DockPanel>
                      <TextBlock Text="Компьютеры Windows Server" Style="{StaticResource SectionTitle}"/>
                      <Border DockPanel.Dock="Right" Background="#DDF3EF" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right">
                        <TextBlock x:Name="ComputerCountText" Foreground="{StaticResource AccentDeepBrush}" FontWeight="SemiBold" FontSize="12"/>
                      </Border>
                    </DockPanel>
                  </Border>
                  <DataGrid x:Name="ComputersGrid"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.Header>
                          <CheckBox x:Name="SelectAllComputersBox"
                                    IsThreeState="True"
                                    ToolTip="Выбрать все / снять все"
                                    Click="SelectAllComputers_Click"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Focusable="False"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                      <DataGridTextColumn Header="ОС" Binding="{Binding OperatingSystem}" Width="200"/>
                      <DataGridTextColumn Header="Расположение" Binding="{Binding Location}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
            </Grid>
          </DockPanel>
        </TabItem>

        <TabItem x:Name="GroupsTab" Header="2 · Группы">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="168" MinHeight="120"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="*" MinHeight="120"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Surface}" Padding="16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                  <TextBlock Text="Параметры текущей задачи" Style="{StaticResource SectionTitle}"/>
                  <Button DockPanel.Dock="Right" Content="Из настроек" Style="{StaticResource Btn}"
                          HorizontalAlignment="Right" Height="30" Click="ResetTaskFields_Click"
                          ToolTip="Подставить шаблон и OU из сохранённых настроек"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                           Text="Можно менять для этой сессии. В настройках хранится значение по умолчанию."/>

                <TextBlock Grid.Row="2" Text="Шаблон имени" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TaskTemplateBox" Style="{StaticResource MonoBox}" Margin="0,0,0,10"
                         ToolTip="Обязателен плейсхолдер {ComputerName}"/>

                <TextBlock Grid.Row="3" Text="Куда создавать" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="3" Grid.Column="1">
                  <TextBox x:Name="TaskGroupsOuBox" Style="{StaticResource MonoBox}" TextChanged="TaskGroupsOuBox_TextChanged"/>
                  <TextBlock x:Name="TaskGroupsOuFriendly" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="#C5D0DB"
                          ShowsPreview="True"
                          Cursor="SizeNS"
                          ToolTip="Высота параметров / сопоставления"/>

            <Border Grid.Row="2" Style="{StaticResource Surface}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                  <TextBlock Text="Сопоставление компьютер → группа" Style="{StaticResource SectionTitle}"/>
                </Border>
                <DataGrid x:Name="MappingsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Компьютер" Binding="{Binding ComputerName}" Width="180"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="240"/>
                    <DataGridTextColumn Header="В AD" Binding="{Binding Status}" Width="120"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button Content="Обновить сопоставление" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="RefreshMappings_Click"/>
              <Button x:Name="GroupsNextButton" Content="К локальным админам →" Style="{StaticResource BtnPrimary}" Click="GroupsNext_Click"/>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="LocalTab" Header="3 · Локальные админы">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <Border Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Поведение" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                  <CheckBox x:Name="OptAddLocal" Content="Добавить целевую группу в локальную группу Administrators"/>
                  <CheckBox x:Name="OptMigrate" Content="Перенести прямых членов в целевую AD-группу (группы — распаковать до пользователей)"/>
                  <CheckBox x:Name="OptExpand" Content="Распаковывать вложенные группы (кроме защищённых Domain Admins и т.п.)"/>
                  <CheckBox x:Name="OptRemove" Content="Удалить из Administrators всех, кроме целевых групп и защищённых" Margin="0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource WarnBanner}">
                <StackPanel Orientation="Horizontal">
                  <Border Width="4" Background="{StaticResource WarnBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                  <TextBlock TextWrapping="Wrap" Foreground="#6B4A18" VerticalAlignment="Center"
                             Text="Очистка необратима. Перед применением сделайте «Бэкап Administrators» на вкладке «Выполнение», затем «Показать план (dry-run)»."/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <TextBlock x:Name="ProbeStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
              <Button Content="Прочитать отмеченные" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="ProbeLocal_Click"
                      ToolTip="Читает все серверы с галкой на вкладке «Источник». Ошибка на одном не останавливает остальные."/>
              <Button Content="К выполнению →" Style="{StaticResource BtnPrimary}" Click="GoRun_Click"/>
            </StackPanel>

            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource Surface}" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Сервер" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox Grid.Column="1" x:Name="LocalProbeServerBox"
                            DisplayMemberPath="Display"
                            SelectionChanged="LocalProbeServer_SelectionChanged"
                            ToolTip="Выберите сервер из уже прочитанных — слева/справа покажется его снимок"/>
                  <TextBlock Grid.Column="2" x:Name="LocalProbeCountText" Margin="12,0,0,0"
                             VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="160"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*" MinWidth="160"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Surface}">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                      <TextBlock x:Name="LocalNowHeader" Text="Сейчас в Administrators" Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <ListBox x:Name="LocalNowList"/>
                  </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="#C5D0DB"
                              ShowsPreview="True"
                              Cursor="SizeWE"
                              ToolTip="Ширина «сейчас» / «после»"/>

                <Border Grid.Column="2" Style="{StaticResource Surface}">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                      <StackPanel>
                        <TextBlock x:Name="LocalAfterHeader" Text="Прогноз после apply" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Для выбранного сервера: кого добавим в AD-группу и кто останется в Administrators"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <ListBox x:Name="LocalAfterList"/>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="RunTab" Header="4 · Выполнение">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="140" MinHeight="72"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="*" MinHeight="100"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock Text="Что делают кнопки" Style="{StaticResource SectionTitle}"/>
                  <Border x:Name="RunModeBadge" DockPanel.Dock="Right" Background="#DDF3EF" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="RunModeText" Text="ещё нет плана" Foreground="{StaticResource AccentDeepBrush}" FontWeight="SemiBold" FontSize="12"/>
                  </Border>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="20"
                           Text="1) «Показать план» — dry-run.&#x0a;2) «Бэкап Administrators» — снимок.&#x0a;3) «Экспорт плана».&#x0a;4) «Применить план» — выполнение + запись в историю.&#x0a;[SKIP] — уже сделано; [CONFLICT] — состав Administrators изменился с прошлого apply."/>
                <CheckBox x:Name="OptUseHistory" Content="Учитывать историю (не повторять уже сделанное)" Margin="0,10,0,0" IsChecked="True"/>
                <TextBlock x:Name="PlanSummaryText" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Surface}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                  <DockPanel>
                    <TextBlock Text="История применений" Style="{StaticResource SectionTitle}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Обновить" Style="{StaticResource Btn}" Height="28" MinWidth="80" Margin="0,0,8,0" Click="RefreshHistory_Click"/>
                      <Button Content="Diff с прошлым" Style="{StaticResource Btn}" Height="28" MinWidth="110" Margin="0,0,8,0" Click="ShowAdminsDiff_Click"
                              ToolTip="Сравнить текущих Administrators с снимком из истории (отмеченные на «Источнике»)"/>
                      <Button Content="Сбросить по отмеченным" Style="{StaticResource Btn}" Height="28" MinWidth="140" Click="ClearHistorySelected_Click"
                              ToolTip="Удалить записи истории для серверов с галкой на «Источнике»"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Сервер" Binding="{Binding Computer}" Width="140"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding TargetGroup}" Width="180"/>
                    <DataGridTextColumn Header="Когда" Binding="{Binding AppliedLocal}" Width="130"/>
                    <DataGridTextColumn Header="Кто" Binding="{Binding AppliedBy}" Width="140"/>
                    <DataGridTextColumn Header="Опции" Binding="{Binding OptionsFingerprint}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <GridSplitter Grid.Row="2"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="#C5D0DB"
                          ShowsPreview="True"
                          Cursor="SizeNS"
                          ToolTip="Высота истории / журнала плана"/>

            <Border Grid.Row="3" Style="{StaticResource Surface}" Background="#0F1C2B" BorderBrush="#1E3348">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="#152536" Padding="14,11" BorderBrush="#1E3348" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                  <DockPanel>
                    <TextBlock Text="Журнал" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" Foreground="#D5E4EF"/>
                    <TextBlock x:Name="JournalHintText" DockPanel.Dock="Right" Foreground="#7EB8AE" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Text="ожидание dry-run"/>
                  </DockPanel>
                </Border>
                <TextBox x:Name="PlanLogBox"
                         Style="{StaticResource LogBox}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>
              </DockPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button Content="Показать план (dry-run)" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BuildPlan_Click"
                      ToolTip="Без изменений в AD и на серверах"/>
              <Button Content="Бэкап Administrators" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Backup_Click"
                      ToolTip="Сохранить текущих членов Administrators с выбранных серверов"/>
              <Button Content="Экспорт плана" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="ExportPlan_Click"/>
              <Button Content="Применить план" Style="{StaticResource BtnPrimary}" Click="Apply_Click"
                      ToolTip="Выполнить план: создать группы, перенести членов, изменить Administrators"/>
            </StackPanel>
          </Grid>
        </TabItem>


        <TabItem x:Name="SqlTab" Header="5 · SQL sysadmin" Visibility="Collapsed">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="SQL на отмеченных серверах" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="«Найти SQL» → план → применить. Windows Auth = пользователь процесса. В SQL только добавить нашу группу в sysadmin; чужие login не удаляются."/>
                <TextBlock x:Name="SqlProviderInfoText" Margin="0,8,0,8" Foreground="{StaticResource AccentDeepBrush}" FontWeight="SemiBold"/>
                <Grid Margin="0,4,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Шаблон группы" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" x:Name="SqlTaskTemplateBox" Style="{StaticResource MonoBox}" Margin="0,0,8,0"
                           ToolTip="По умолчанию из Настроек (SqlGroupNameTemplate). {ComputerName} обязателен."/>
                  <Button Grid.Column="2" Content="Из настроек" Style="{StaticResource Btn}" Height="30"
                          Click="ResetSqlTemplate_Click" ToolTip="Подставить SqlGroupNameTemplate из сохранённых настроек"/>
                </Grid>
                <CheckBox x:Name="OptSqlMigrate" Margin="0,0,0,6"
                          Content="Перенести доменных sysadmin в целевую AD-группу — без удалений в SQL"
                          ToolTip="Явные Windows-члены sysadmin → AD-группа. Компьютеры (*$) и защищённые — пропуск."/>
                <CheckBox x:Name="OptSqlExpand" Margin="0"
                          Content="Распаковывать вложенные группы до пользователей (как в Local Admins)"
                          ToolTip="Та же логика ExpandNestedGroupsOnMigrate: группы из sysadmin разворачиваются, защищённые не трогаем."/>
              </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <TextBlock x:Name="SqlStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
              <Button Content="Найти SQL" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="SqlDiscover_Click"
                      ToolTip="WMI: службы MSSQL* + проверка Windows Auth к инстансу"/>
              <Button Content="Показать план SQL" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="SqlBuildPlan_Click"/>
              <Button Content="Применить к SQL" Style="{StaticResource BtnPrimary}" Click="SqlApply_Click"
                      ToolTip="CREATE LOGIN FROM WINDOWS + sysadmin только где SQL найден и доступен"/>
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Surface}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
                    <TextBlock Text="Discovery" Style="{StaticResource SectionTitle}"/>
                  </Border>
                  <DataGrid x:Name="SqlDiscoveryGrid"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Компьютер" Binding="{Binding ComputerName}" Width="120"/>
                      <DataGridTextColumn Header="SQL" Binding="{Binding SqlLabel}" Width="80"/>
                      <DataGridTextColumn Header="Инстанс" Binding="{Binding InstancesText}" Width="140"/>
                      <DataGridTextColumn Header="Доступ" Binding="{Binding Access}" Width="100"/>
                      <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="160"/>
                      <DataGridTextColumn Header="Деталь" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>

              <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#C5D0DB" Cursor="SizeWE"/>

              <Border Grid.Column="2" Style="{StaticResource Surface}" Background="#0F1C2B" BorderBrush="#1E3348">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Background="#152536" Padding="14,11" BorderBrush="#1E3348" BorderThickness="0,0,0,1">
                    <TextBlock Text="План SQL" Foreground="#D5E4EF" FontWeight="SemiBold"/>
                  </Border>
                  <TextBox x:Name="SqlPlanBox" Style="{StaticResource LogBox}" IsReadOnly="True"
                           AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
              </Border>
            </Grid>
          </DockPanel>
        </TabItem>

      </TabControl>
    </Grid>

    <GridSplitter Grid.Row="2"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  Background="#C5D0DB"
                  ShowsPreview="True"
                  Cursor="SizeNS"
                  ToolTip="Потяните, чтобы изменить высоту лога"/>

    <Border Grid.Row="3" Background="#E8EEF4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="18,6,18,4">
          <TextBlock x:Name="FooterText" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Border x:Name="LogLevelBadge" Background="#DDF3EF" CornerRadius="8" Padding="8,2" Margin="0,0,8,0">
              <TextBlock x:Name="LogLevelText" Text="лог" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDeepBrush}"/>
            </Border>
            <Button Content="Очистить лог" Style="{StaticResource Btn}" Height="26" MinWidth="90" Padding="10,0" Click="ClearAppLog_Click"/>
          </StackPanel>
        </DockPanel>
        <TextBox x:Name="AppLogBox"
                 Style="{StaticResource AppLogBox}"
                 Margin="18,0,18,8"
                 IsReadOnly="True"
                 Focusable="False"
                 IsTabStop="False"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>

