<Window x:Class="AdServerGroups.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        SizeToContent="Height"
        Width="520"
        MinWidth="440"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ClipToBounds="False">
  <Grid ClipToBounds="False">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20,16" ClipToBounds="False">
      <StackPanel Orientation="Horizontal">
        <Border Width="4" Background="{StaticResource WarnBrush}" CornerRadius="2" Margin="0,4,12,4"/>
        <StackPanel>
          <!-- Без BrandTitle: у крупных шрифтов срезались верхние засечки -->
          <TextBlock x:Name="TitleText" Text="Подтверждение"
                     FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="SemiBold"
                     Foreground="White" TextWrapping="Wrap" LineHeight="24" Padding="0,2"/>
          <TextBlock Text="Проверьте действие перед применением"
                     FontFamily="{StaticResource UiFont}" FontSize="12"
                     Foreground="#A8C0CC" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="20,16" Background="{StaticResource WarnBgBrush}"
            BorderBrush="#E2C48A" BorderThickness="1" CornerRadius="6"
            Padding="16,14" ClipToBounds="False">
      <TextBlock x:Name="MessageText"
                 TextWrapping="Wrap"
                 TextAlignment="Left"
                 VerticalAlignment="Top"
                 FontFamily="{StaticResource UiFont}"
                 FontSize="13"
                 LineHeight="20"
                 Padding="0,2"
                 Foreground="#6B4A18"/>
    </Border>

    <Border Grid.Row="2" Background="#E8EEF4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="YesButton" Content="Продолжить" Style="{StaticResource BtnPrimary}" MinWidth="120" Margin="0,0,8,0"
                IsDefault="True" Click="Yes_Click"/>
        <Button Content="Отмена" Style="{StaticResource Btn}" MinWidth="110" IsCancel="True" Click="No_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
