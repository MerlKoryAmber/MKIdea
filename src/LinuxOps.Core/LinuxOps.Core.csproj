<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ядро LinuxOps: SSH, скрипты действий, план, каталог, история, «Версии ПО», CVE, обновление отмеченного.
       Без WPF и Windows — общее для настольного LinuxOps и LinuxOps.Web. Пространства имён прежние (LinuxOps.Services, LinuxOps.Models). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LinuxOps</RootNamespace>
    <Version>0.3.54</Version>
    <AssemblyVersion>0.3.54.0</AssemblyVersion>
    <FileVersion>0.3.54.0</FileVersion>
    <Company>Merl</Company>
    <Product>LinuxOps</Product>
    <Copyright>Copyright © Merl 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
