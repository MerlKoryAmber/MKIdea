<Window x:Class="LinuxOps.RdpConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение RDP" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="20,16">
    <TextBlock x:Name="HostText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="Учётная запись" FontWeight="SemiBold" Margin="0,0,0,2"/>
    <TextBox x:Name="UserBox" AutomationProperties.AutomationId="RdpUser"/>
    <TextBlock Text="ДОМЕН\логин или логин@домен." Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,8"/>
    <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,2"/>
    <PasswordBox x:Name="PassBox" AutomationProperties.AutomationId="RdpPassword"/>
    <TextBlock x:Name="PassHint" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8"/>
    <StackPanel Margin="0,2,0,0">
      <CheckBox x:Name="RcgBox" Content="Remote Credential Guard" Margin="0,0,0,4"
                Checked="Rcg_Checked" Unchecked="Auth_Changed" AutomationProperties.AutomationId="RdpRcg"/>
      <CheckBox x:Name="RestrictedBox" Content="Restricted Admin" Margin="0,0,0,4"
                Checked="Restricted_Checked" Unchecked="Auth_Changed" AutomationProperties.AutomationId="RdpRestricted"/>
      <CheckBox x:Name="AdminBox" Content="Консольная сессия (/admin)" Margin="0,0,0,4" AutomationProperties.AutomationId="RdpAdmin"/>
      <CheckBox x:Name="DrivesBox" Content="Локальные диски (на сервере — \\tsclient)" Margin="0,0,0,4" AutomationProperties.AutomationId="RdpDrives"/>
      <CheckBox x:Name="PrintersBox" Content="Принтеры" AutomationProperties.AutomationId="RdpPrinters"/>
    </StackPanel>
    <TextBlock Text="Буфер обмена передаётся всегда. Пароль живёт в памяти до закрытия вкладки сессии — для переподключения."
               Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Style="{StaticResource Btn}" Width="100" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Подключить" Style="{StaticResource BtnPrimary}" Width="130" IsDefault="True" Click="Connect_Click"
              AutomationProperties.AutomationId="RdpConnect"/>
    </StackPanel>
  </StackPanel>
</Window>
