<Window x:Class="LinuxOps.VsphereWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vSphere — модули и vCenter" Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="20,16">
    <!-- PowerCLI -->
    <TextBlock Text="Модули PowerCLI" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
    <TextBlock x:Name="CoreText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="VsCore"/>
    <TextBlock x:Name="DirText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,10"/>
    <WrapPanel Margin="0,0,0,4">
      <Button Content="Скачать из интернета" Style="{StaticResource BtnPrimary}" Height="28" Margin="0,0,6,6" Click="Download_Click"
              ToolTip="PowerShell Gallery: только нужное для vSphere (VMware.VimAutomation.Core и зависимости)"/>
      <Button Content="Установить из ZIP…" Style="{StaticResource Btn}" Height="28" Margin="0,0,6,6" Click="FromZip_Click"
              ToolTip="Наш экспорт или офлайн-архив PowerCLI с сайта Broadcom"/>
      <Button Content="Из папки…" Style="{StaticResource Btn}" Height="28" Margin="0,0,6,6" Click="FromFolder_Click"/>
      <Button Content="Сохранить в ZIP…" Style="{StaticResource Btn}" Height="28" Margin="0,0,6,6" Click="Export_Click"
              ToolTip="Все модули одним архивом — перенести на машину без интернета"/>
      <Button Content="Открыть папку" Style="{StaticResource Btn}" Height="28" Margin="0,0,6,6" Click="OpenDir_Click"/>
    </WrapPanel>
    <TextBlock Text="Без интернета: скачайте модули на машине с интернетом и перенесите ZIP, либо скопируйте папку LinuxOps целиком — вместе с Modules."
               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBlock x:Name="ProgressText" Foreground="{DynamicResource AccentDeepBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
               AutomationProperties.AutomationId="VsProgress"/>

    <!-- vCenter -->
    <TextBlock Text="Профили vCenter" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="Добавить" Style="{StaticResource Btn}" Height="28" Margin="0,0,6,0" Click="Add_Click"/>
          <Button Content="Удалить" Style="{StaticResource Btn}" Height="28" Click="Delete_Click"/>
        </StackPanel>
        <ListBox x:Name="Profiles" Height="170" DisplayMemberPath="Title" SelectionChanged="Profiles_SelectionChanged"
                 AutomationProperties.AutomationId="VsProfiles"/>
      </DockPanel>
      <StackPanel x:Name="Form" Grid.Column="2" IsEnabled="False">
        <TextBlock Text="Имя" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox x:Name="NameBox" TextChanged="Form_Changed" AutomationProperties.AutomationId="VsName"/>
        <TextBlock Text="Как профиль называется в списках, например «Прод»." Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,8"/>
        <TextBlock Text="Адрес vCenter" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox x:Name="ServerBox" TextChanged="Form_Changed" AutomationProperties.AutomationId="VsServer"/>
        <TextBlock Text="Имя или IP, например vcenter.merl.loc." Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,8"/>
        <TextBlock Text="Пользователь" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox x:Name="UserBox" TextChanged="Form_Changed" AutomationProperties.AutomationId="VsUser"/>
        <TextBlock Text="Например administrator@vsphere.local. Пароль спрашивается при подключении и живёт до закрытия программы."
                   Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8"/>
        <CheckBox x:Name="CertBox" Content="Самоподписанный сертификат — не проверять" Checked="Form_Changed" Unchecked="Form_Changed"/>
      </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Отмена" Style="{StaticResource Btn}" Width="100" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Width="120" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
