<Window x:Class="LinuxOps.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxOps" SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PaperBrush}" FontFamily="{StaticResource UiFont}">
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="20,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="OkBtn" Content="OK" Style="{StaticResource BtnPrimary}" Width="100" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
        <Button x:Name="NoBtn" Content="Не сохранять" Style="{StaticResource Btn}" MinWidth="100" Margin="0,0,8,0" Visibility="Collapsed" Click="No_Click"/>
        <Button x:Name="CancelBtn" Content="Отмена" Style="{StaticResource Btn}" Width="100" IsCancel="True" Click="Cancel_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border x:Name="IconBox" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BadgeBgBrush}" Margin="0,0,14,0"
                VerticalAlignment="Top">
          <TextBlock x:Name="IconText" Text="i" FontWeight="Bold" FontSize="16"
                     Foreground="{DynamicResource AccentDeepBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}" FontSize="13.5"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
