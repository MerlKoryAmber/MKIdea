<Window x:Class="LinuxOps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LinuxOps.Views"
        Title="LinuxOps"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20,14">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Right" x:Name="FooterVersionText"
                   Foreground="#8EB8B0" VerticalAlignment="Center" FontSize="12"/>
        <Button DockPanel.Dock="Right" x:Name="SettingsBtn" Style="{StaticResource BtnHeader}" Margin="0,0,14,0"
                ToolTip="Настройки: тема, редактор F4" Click="Settings_Click"
                Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="LinuxOps" Style="{StaticResource BrandTitle}" Margin="0,0,22,0" VerticalAlignment="Center"/>
          <ToggleButton x:Name="ChipInventory" Content="Inventory" Style="{StaticResource ModeChip}"
                        Checked="ModeChip_Checked" Unchecked="ModeChip_Unchecked" Tag="inventory"/>
          <ToggleButton x:Name="ChipActions" Content="Actions" Style="{StaticResource ModeChip}"
                        IsChecked="True" Checked="ModeChip_Checked" Unchecked="ModeChip_Unchecked" Tag="actions"/>
          <ToggleButton x:Name="ChipSsh" Content="SSH Files" Style="{StaticResource ModeChip}"
                        Checked="ModeChip_Checked" Unchecked="ModeChip_Unchecked" Tag="ssh"/>
          <ToggleButton x:Name="ChipTerminal" Content="SSH Terminal" Style="{StaticResource ModeChip}"
                        Checked="ModeChip_Checked" Unchecked="ModeChip_Unchecked" Tag="terminal"/>
          <ToggleButton x:Name="ChipPowerShell" Content="PowerShell" Style="{StaticResource ModeChip}"
                        Checked="ModeChip_Checked" Unchecked="ModeChip_Unchecked" Tag="powershell"/>
          <ToggleButton x:Name="ChipHistory" Content="History" Style="{StaticResource ModeChip}"
                        Checked="ModeChip_Checked" Unchecked="ModeChip_Unchecked" Tag="history"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <views:ActionsView x:Name="Actions" Grid.Row="1"/>
    <views:InventoryView x:Name="Inventory" Grid.Row="1" Visibility="Collapsed"/>
    <views:FilesTabsView x:Name="Ssh" Grid.Row="1" Visibility="Collapsed"/>
    <views:TerminalTabsView x:Name="Terminal" Grid.Row="1" Visibility="Collapsed"/>
    <views:PowerShellView x:Name="PowerShell" Grid.Row="1" Visibility="Collapsed"/>
    <views:HistoryView x:Name="History" Grid.Row="1" Visibility="Collapsed"/>

    <Border x:Name="FooterBar" Grid.Row="2" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
      <DockPanel>
        <StackPanel x:Name="ActionsFooter" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Очистить план" Style="{StaticResource Btn}" Margin="0,0,8,0"
                  Command="{Binding DataContext.ClearResultsCommand, ElementName=Actions}"/>
          <Button Content="Стоп" Style="{StaticResource Btn}" Width="90" Margin="0,0,8,0"
                  Command="{Binding DataContext.CancelCommand, ElementName=Actions}"/>
          <Button Content="Dry-run" Style="{StaticResource Btn}" Width="120" Margin="0,0,8,0"
                  Command="{Binding DataContext.DryRunCommand, ElementName=Actions}"/>
          <Button Content="Применить" Style="{StaticResource BtnPrimary}" Width="130"
                  Command="{Binding DataContext.ApplyCommand, ElementName=Actions}"/>
        </StackPanel>
        <TextBlock x:Name="DefaultsPathText" Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
