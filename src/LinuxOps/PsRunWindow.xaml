<Window x:Class="LinuxOps.PsRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры действий" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="20,16">
    <TextBlock x:Name="Hint" Text="Значения передаются в скрипт как есть. Последние запоминаются до закрытия программы."
               Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <StackPanel x:Name="ParamsPanel"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Отмена" Style="{StaticResource Btn}" Width="100" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Запустить" Style="{StaticResource BtnPrimary}" Width="120" IsDefault="True" Click="Ok_Click"
              AutomationProperties.AutomationId="PsRunOk"/>
    </StackPanel>
  </StackPanel>
</Window>
