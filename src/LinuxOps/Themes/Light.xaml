<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Дневная палитра. Ключи такие же, как в Dark.xaml: ThemeManager подменяет словарь целиком. -->
  <Color x:Key="InkColor">#102033</Color>
  <Color x:Key="PaperColor">#E8EEF4</Color>
  <Color x:Key="LineColor">#C5D0DB</Color>
  <Color x:Key="TextColor">#15202B</Color>
  <Color x:Key="MutedColor">#5A6B7D</Color>
  <Color x:Key="AccentColor">#1A9B8E</Color>
  <Color x:Key="AccentDeepColor">#117A70</Color>
  <Color x:Key="WarnColor">#C4852C</Color>
  <Color x:Key="WarnBgColor">#F8EBD4</Color>

  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardLineBrush" Color="#E6EDF3"/>
  <SolidColorBrush x:Key="ChipBgBrush" Color="#EEF3F7"/>
  <SolidColorBrush x:Key="ChipTextBrush" Color="#3D5668"/>
  <SolidColorBrush x:Key="ToolbarWellBrush" Color="#FAFCFD"/>
  <SolidColorBrush x:Key="ConsoleBrush" Color="#0F1C2B"/>
  <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#1E3348"/>
  <SolidColorBrush x:Key="ConsoleTextBrush" Color="#D7E0D8"/>
  <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="#152536"/>
  <SolidColorBrush x:Key="OnlineBrush" Color="#2F9E6F"/>
  <SolidColorBrush x:Key="OfflineBrush" Color="#C45C5C"/>
  <SolidColorBrush x:Key="UnknownBrush" Color="#8A9AAB"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#C45C5C"/>

  <!-- Поверхности и выделение -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F3F7"/>
  <SolidColorBrush x:Key="HeaderCellBrush" Color="#F7FAFC"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#F7FAFC"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#E8F7F4"/>
  <SolidColorBrush x:Key="HoverSoftBrush" Color="#F3F9F7"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#D4EFEA"/>
  <SolidColorBrush x:Key="SelectedInactiveBrush" Color="#E4ECEF"/>
  <SolidColorBrush x:Key="BadgeBgBrush" Color="#E8F4F2"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5D0DB"/>
  <SolidColorBrush x:Key="TermSelectionBrush" Color="#3D6A8C"/>
</ResourceDictionary>
