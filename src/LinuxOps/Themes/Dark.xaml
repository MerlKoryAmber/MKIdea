<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ночная палитра. Ключи такие же, как в Light.xaml. -->
  <Color x:Key="InkColor">#0B1118</Color>
  <Color x:Key="PaperColor">#0F151C</Color>
  <Color x:Key="LineColor">#2B3947</Color>
  <Color x:Key="TextColor">#DCE5ED</Color>
  <Color x:Key="MutedColor">#8C9DAE</Color>
  <Color x:Key="AccentColor">#22B3A4</Color>
  <Color x:Key="AccentDeepColor">#3CC7B8</Color>
  <Color x:Key="WarnColor">#D9A04A</Color>
  <Color x:Key="WarnBgColor">#3A2F1C</Color>

  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardLineBrush" Color="#24313E"/>
  <SolidColorBrush x:Key="ChipBgBrush" Color="#1F2B37"/>
  <SolidColorBrush x:Key="ChipTextBrush" Color="#A9BCCB"/>
  <SolidColorBrush x:Key="ToolbarWellBrush" Color="#1A2430"/>
  <SolidColorBrush x:Key="ConsoleBrush" Color="#0A1119"/>
  <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#22313F"/>
  <SolidColorBrush x:Key="ConsoleTextBrush" Color="#D7E0D8"/>
  <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="#121C27"/>
  <SolidColorBrush x:Key="OnlineBrush" Color="#3DBA85"/>
  <SolidColorBrush x:Key="OfflineBrush" Color="#D86A6A"/>
  <SolidColorBrush x:Key="UnknownBrush" Color="#7F8FA0"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#E07A7A"/>

  <!-- Поверхности и выделение -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#17202A"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C2732"/>
  <SolidColorBrush x:Key="HeaderCellBrush" Color="#1A2430"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#1A232D"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#1E3533"/>
  <SolidColorBrush x:Key="HoverSoftBrush" Color="#1B2B2E"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#21504B"/>
  <SolidColorBrush x:Key="SelectedInactiveBrush" Color="#263844"/>
  <SolidColorBrush x:Key="BadgeBgBrush" Color="#1E3533"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4A5A"/>
  <SolidColorBrush x:Key="TermSelectionBrush" Color="#2F5878"/>
</ResourceDictionary>
