<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.3.39</Version>
    <AssemblyVersion>0.3.39.0</AssemblyVersion>
    <FileVersion>0.3.39.0</FileVersion>
    <InformationalVersion>0.3.39</InformationalVersion>
    <Company>Merl</Company>
    <Product>LinuxOps</Product>
    <AssemblyTitle>LinuxOps</AssemblyTitle>
    <Description>SSH checks and actions for Linux hosts from Windows</Description>
    <Copyright>Copyright © Merl 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LinuxOps.defaults.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Actions\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Actions" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

  <!-- Notepad++ portable для F4: распаковать рядом с exe в Tools\Notepad++ (см. third_party/notepad++/README.md). -->
  <PropertyGroup>
    <NppZip>$(MSBuildThisFileDirectory)..\..\third_party\notepad++\npp.8.9.8.1.portable.x64.zip</NppZip>
  </PropertyGroup>
  <Target Name="BundleNotepadPlusPlusBuild" AfterTargets="Build" Condition="Exists('$(NppZip)') And !Exists('$(OutDir)Tools\Notepad++\notepad++.exe')">
    <Unzip SourceFiles="$(NppZip)" DestinationFolder="$(OutDir)Tools\Notepad++" OverwriteReadOnlyFiles="true" />
  </Target>
  <Target Name="BundleNotepadPlusPlus" AfterTargets="Publish" Condition="Exists('$(NppZip)')">
    <RemoveDir Directories="$(PublishDir)Tools\Notepad++" />
    <Unzip SourceFiles="$(NppZip)" DestinationFolder="$(PublishDir)Tools\Notepad++" OverwriteReadOnlyFiles="true" />
  </Target>

  <!-- Движок PowerShell (вкладка PowerShell, PS-действия): отдельный процесс в pwsh\ рядом с exe.
       PsProtocol.cs общий с LinuxOps.PsHost — подключён туда ссылкой. -->
  <PropertyGroup>
    <PsHostProj>$(MSBuildThisFileDirectory)..\LinuxOps.PsHost\LinuxOps.PsHost.csproj</PsHostProj>
  </PropertyGroup>
  <Target Name="BundlePsHostBuild" AfterTargets="Build" Condition="!Exists('$(OutDir)pwsh\LinuxOps.PsHost.exe')">
    <Exec Command="dotnet publish &quot;$(PsHostProj)&quot; -c $(Configuration) --self-contained true -o &quot;$(OutDir)pwsh&quot; -v q -nologo" />
  </Target>
  <Target Name="BundlePsHost" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(PsHostProj)&quot; -c $(Configuration) --self-contained true -o &quot;$(PublishDir)pwsh&quot; -v q -nologo" />
  </Target>

</Project>
