<Window x:Class="LinuxOps.AccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Закрыть доступ" Height="640" Width="760" MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Логин" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
      <ComboBox x:Name="LoginBox" IsEditable="True" Height="28" Margin="0,4,0,12"
                ToolTip="Можно выбрать из базовых пользователей или ввести вручную"/>

      <StackPanel x:Name="ModesPanel">
        <RadioButton x:Name="ModeLock" GroupName="Mode" IsChecked="True" Margin="0,0,0,2" Checked="Mode_Checked">
          <TextBlock FontWeight="SemiBold" Text="Заблокировать"/>
        </RadioButton>
        <TextBlock Margin="22,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                   Text="Вход по паролю и ключу закрыт, sudo снят, процессы завершены. Всё можно вернуть — «Открыть доступ»."/>
        <RadioButton x:Name="ModeKey" GroupName="Mode" Margin="0,0,0,2" Checked="Mode_Checked">
          <TextBlock FontWeight="SemiBold" Text="Отозвать ключ"/>
        </RadioButton>
        <TextBlock Margin="22,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                   Text="Убрать один SSH-ключ из authorized_keys. Учётная запись и остальные ключи остаются."/>
        <RadioButton x:Name="ModeDelete" GroupName="Mode" Margin="0,0,0,2" Checked="Mode_Checked">
          <TextBlock FontWeight="SemiBold" Text="Удалить учётную запись"/>
        </RadioButton>
        <TextBlock Margin="22,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                   Text="Домашняя папка — в архив /root/linuxops-removed на том же хосте, затем userdel -r. Не вернуть."/>
      </StackPanel>
      <TextBlock x:Name="UnlockHint" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap"
                 Foreground="{DynamicResource MutedBrush}" FontSize="12"
                 Text="Снять блокировку LinuxOps: пароль, срок учётной записи, ключи, группы sudo и файл sudoers вернутся как были до блокировки."/>

      <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,0,8">
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Файл…" Style="{StaticResource Btn}" Height="28" MinWidth="80" Margin="8,0,0,0" Click="PickKey_Click"/>
          <TextBlock Text="Открытый ключ (строка ssh-ed25519 … или .pub)" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="KeyBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 TextChanged="Input_Changed"/>
        <TextBlock x:Name="FpText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
      </StackPanel>

      <DockPanel Margin="0,4,0,6">
        <Button x:Name="CheckBtn" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource Btn}" Height="28" MinWidth="110" Click="Check_Click"/>
        <TextBlock x:Name="HostsText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
      </DockPanel>
    </StackPanel>

    <ListView x:Name="PreviewList" Grid.Row="1" Margin="0,0,0,8">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Хост" Width="140" DisplayMemberBinding="{Binding Host}"/>
          <GridViewColumn Header="Сейчас" Width="210">
            <GridViewColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Now}" TextWrapping="Wrap"/></DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Будет сделано" Width="340">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Plan}" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Applicable}" Value="False">
                          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
    <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
               Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
               Text="«Проверить» — посмотреть на отмеченных хостах, что будет сделано. Ничего не меняется."/>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,0,0,8">
          <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" FontSize="12"/>
          <TextBox x:Name="ConfirmBox" Height="28" Margin="0,4,0,0" TextChanged="Confirm_Changed"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,8"/>
      </StackPanel>
      <DockPanel Grid.Row="1">
        <Button x:Name="SwitchBtn" DockPanel.Dock="Left" Content="Открыть доступ…" Style="{StaticResource Btn}" Height="30" MinWidth="140"
                Click="Switch_Click" ToolTip="Снять блокировку, поставленную LinuxOps"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Отмена" Style="{StaticResource Btn}" Width="110" Height="30" Margin="0,0,8,0" IsCancel="True"/>
          <Button x:Name="OkBtn" Content="Закрыть доступ" Style="{StaticResource BtnPrimary}" MinWidth="150" Height="30" Padding="12,0"
                  IsEnabled="False" Click="Ok_Click"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
