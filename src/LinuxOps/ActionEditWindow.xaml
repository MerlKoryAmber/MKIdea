<Window x:Class="LinuxOps.ActionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxOps · Редактор действия"
        Height="680" Width="720"
        MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="BannerText" Visibility="Collapsed"/>
        <TextBlock Text="Имя" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10" Height="32" VerticalContentAlignment="Center" AutomationProperties.AutomationId="ActName"/>

        <TextBlock Text="Описание" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <TextBox x:Name="DescBox" Margin="0,0,0,10" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

        <TextBlock Text="Тип" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="KindBox_SelectionChanged" AutomationProperties.AutomationId="ActKind">
          <ComboBoxItem Content="Bash по SSH — на отмеченных хостах Linux"/>
          <ComboBoxItem Content="PowerShell — против vCenter (PowerCLI)"/>
        </ComboBox>
        <TextBlock x:Name="KindHint" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,10"
                   Text="Скрипт выполняется на каждом отмеченном хосте."/>

        <StackPanel x:Name="PsPanel" Visibility="Collapsed">
          <TextBlock Text="Параметры" Margin="0,0,0,4" FontWeight="SemiBold"/>
          <TextBox x:Name="ParamsBox" Height="64" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.AutomationId="ActParams"/>
          <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                     Text="По строке: Имя = значение по умолчанию | подпись. Спрашиваются перед запуском, в скрипте — переменная $Имя. Подключение к vCenter LinuxOps делает сам."/>
        </StackPanel>

        <StackPanel x:Name="BashPanel">
        <TextBlock Text="Дистрибутивы" Margin="0,0,0,6" FontWeight="SemiBold"/>
        <WrapPanel x:Name="DistroPanel" Margin="0,0,0,12">
          <CheckBox x:Name="DUbuntu" Content="Ubuntu" Margin="0,0,12,6" IsChecked="True"/>
          <CheckBox x:Name="DDebian" Content="Debian" Margin="0,0,12,6" IsChecked="True"/>
          <CheckBox x:Name="DRhel" Content="RHEL" Margin="0,0,12,6" IsChecked="True"/>
          <CheckBox x:Name="DAlma" Content="Alma" Margin="0,0,12,6" IsChecked="True"/>
          <CheckBox x:Name="DSuse" Content="SUSE" Margin="0,0,12,6"/>
          <CheckBox x:Name="DAny" Content="any" Margin="0,0,12,6"/>
        </WrapPanel>
        </StackPanel>

        <DockPanel Margin="0,0,0,12">
          <StackPanel x:Name="PrivPanel" Width="200" Margin="0,0,16,0">
            <TextBlock Text="Привилегии" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <ComboBox x:Name="PrivBox" SelectedIndex="0">
              <ComboBoxItem Content="sudo/root"/>
              <ComboBoxItem Content="user"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Width="120">
            <TextBlock Text="Таймаут, сек" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <TextBox x:Name="TimeoutBox" Text="60"/>
          </StackPanel>
          <CheckBox x:Name="DestructiveBox" Content="Destructive (нужен Apply)"
                    VerticalAlignment="Bottom" Margin="16,0,0,4"/>
        </DockPanel>

        <TextBlock Text="Скрипт" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <TextBox x:Name="ScriptBox" MinHeight="280" AutomationProperties.AutomationId="ActScript" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Text="# {{host}} {{user}}&#x0a;set -e&#x0a;uname -a&#x0a;"/>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" Style="{StaticResource Btn}" Width="110" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="SaveBtn" Content="Сохранить действие" Style="{StaticResource BtnPrimary}" Width="170" Click="Save_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
