<Window x:Class="LinuxOps.HostEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Хост" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Имя" Margin="0,0,0,4"/>
      <TextBox x:Name="NameBox" Margin="0,0,0,10"/>
      <TextBlock Text="Host / IP" Margin="0,0,0,4"/>
      <TextBox x:Name="HostBox" Margin="0,0,0,10"/>
      <DockPanel Margin="0,0,0,10">
        <StackPanel Width="120" Margin="0,0,12,0">
          <TextBlock Text="Port" Margin="0,0,0,4"/>
          <TextBox x:Name="PortBox" Text="22"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="User" Margin="0,0,0,4"/>
          <TextBox x:Name="UserBox"/>
        </StackPanel>
      </DockPanel>
      <TextBlock Text="Auth" Margin="0,0,0,4"/>
      <ComboBox x:Name="AuthBox" Margin="0,0,0,10" SelectedIndex="0">
        <ComboBoxItem Content="Key"/>
        <ComboBoxItem Content="Password"/>
      </ComboBox>
      <TextBlock Text="Путь к ключу (Key)" Margin="0,0,0,4"/>
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Content="Обзор…" Width="90" Margin="8,0,0,0" Click="BrowseKey_Click" Style="{StaticResource Btn}"/>
        <TextBox x:Name="KeyBox"/>
      </DockPanel>
      <TextBlock Text="Пароль (Password)" Margin="0,0,0,4"/>
      <PasswordBox x:Name="PassBox" Margin="0,0,0,10"/>
      <CheckBox x:Name="UseSudoBox" Content="Выполнять через sudo" IsChecked="True" Margin="0,0,0,10"/>
      <Button Content="Проверить подключение" HorizontalAlignment="Left" Style="{StaticResource Btn}" Click="Test_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Style="{StaticResource Btn}" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Width="120" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
