<Window x:Class="LinuxOps.HostKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ключ хоста" Height="240" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="Body" TextWrapping="Wrap" FontSize="13"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Style="{StaticResource Btn}" Width="110" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="TrustBtn" Content="Доверять" Style="{StaticResource BtnPrimary}" Width="160" Click="Trust_Click"/>
    </StackPanel>
  </Grid>
</Window>
