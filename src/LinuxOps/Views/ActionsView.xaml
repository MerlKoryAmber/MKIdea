<UserControl x:Class="LinuxOps.Views.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LinuxOps.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>
    <Grid Margin="28,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.95*" MinWidth="420"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.15*" MinWidth="280"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.2*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Surface}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Хосты и vCenter" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Опросить" Style="{StaticResource Btn}" Height="28" MinWidth="88"
                        Padding="10,0" Margin="8,0,10,0" ToolTip="Хосты — SSH: дистрибутив и статус; vCenter — доступность порта 443"
                        Command="{Binding ProbeCommand}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Text="{Binding HostsSelectedText}"/>
              </Grid>
              <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Добавить пользователя" Style="{StaticResource Btn}" Height="28" Padding="10,0" Margin="0,0,8,6"
                        Command="{Binding AddUserCommand}"/>
                <Button Content="Закрыть доступ" Style="{StaticResource Btn}" Height="28" Padding="10,0" Margin="0,0,8,6"
                        ToolTip="Заблокировать, отозвать ключ или удалить учётную запись на отмеченных хостах. Там же — «Открыть доступ»."
                        Command="{Binding CloseAccessCommand}"/>
                <Button Content="{Binding BaseUsersText}" Style="{StaticResource Btn}" Height="28" Padding="10,0" Margin="0,0,8,6"
                        Command="{Binding OpenBaseUsersCommand}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <CheckBox x:Name="SelectAllHosts" Content="Выбрать все / снять все"
                      IsChecked="{Binding SelectAllChecked, Mode=OneWay}" Click="SelectAllHosts_Click"/>
          </Border>
          <local:ResourceTree x:Name="HostsTree" ShowChecks="True" Margin="8,6,8,4"
                              EmptyMessage="Ресурсов нет. Добавьте хосты Linux и vCenter на вкладке Inventory."/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="2" Style="{StaticResource Surface}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}" Padding="12,6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Новое" Style="{StaticResource Btn}" Height="28" MinWidth="72" Padding="10,0" Command="{Binding AddCommand}"
                      ToolTip="Новое своё действие"/>
              <TextBlock Text="Каталог действий" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                         ToolTip="Щелчок — одно действие, Ctrl или Shift — несколько, двойной — изменить, правая кнопка — меню"/>
            </DockPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ActionsList" ItemsSource="{Binding Actions}" Margin="16,12,16,14" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Рамка и фон — только «в плане». Выделения карточек нет. -->
                  <Border x:Name="CardChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                          CornerRadius="10" Padding="2" Margin="0,0,0,8" SnapsToDevicePixels="True" Cursor="Hand"
                          PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown">
                    <Border.ContextMenu>
                      <ContextMenu Opened="CardMenu_Opened">
                        <MenuItem Header="Изменить" FontWeight="SemiBold" Click="CardEdit_Click"/>
                        <MenuItem Header="Клонировать" Click="CardClone_Click"/>
                        <Separator/>
                        <MenuItem Header="Удалить" Click="CardRemove_Click"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" HorizontalAlignment="Stretch">
                      <DockPanel LastChildFill="True">
                        <CheckBox DockPanel.Dock="Left" ToolTip="В плане" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top" Margin="0,2,10,0"
                                  Checked="PlanCheck_Changed" Unchecked="PlanCheck_Changed"/>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                          <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource AccentDeepBrush}"/>
                          </Border>
                          <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Opacity="0.35">
                            <Button Style="{StaticResource BtnIcon}" Width="28" Height="26" MinWidth="0" Margin="0,0,4,0"
                                    Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                    ToolTip="Изменить (двойной щелчок)" Click="CardEdit_Click"/>
                            <Button Style="{StaticResource BtnIcon}" Width="28" Height="26" MinWidth="0" Margin="0,0,4,0"
                                    Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                    ToolTip="Клонировать — копия, которую можно править" Click="CardClone_Click"/>
                            <Button x:Name="RemoveBtn" Style="{StaticResource BtnIcon}" Width="28" Height="26" MinWidth="0" Margin="0"
                                    Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                    ToolTip="Удалить своё действие" Click="CardRemove_Click"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"
                                     FontSize="12" Margin="0,3,0,6" TextWrapping="Wrap"/>
                          <ItemsControl ItemsSource="{Binding DistroTags}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,6,4">
                                  <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource ChipTextBrush}"/>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="CardChrome" Property="IsMouseOver" Value="True">
                      <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource HoverSoftBrush}"/>
                      <Setter TargetName="Tools" Property="Opacity" Value="1"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Definition.BuiltIn}" Value="True">
                      <Setter TargetName="RemoveBtn" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="4" Style="{StaticResource Surface}" Background="#0F1C2B" BorderBrush="#1E3348">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.55*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="0.45*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#152536" Padding="12,10" BorderBrush="#1E3348" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Запуск плана" Foreground="#D5E4EF" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Right" Foreground="#7EB8AE" FontSize="12" Text="{Binding RunStatus}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
            </DockPanel>
          </Border>
          <!-- Идёт запуск: бегущая полоса под заголовком -->
          <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3" IsIndeterminate="True" BorderThickness="0"
                       Background="Transparent" Foreground="{DynamicResource AccentBrush}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <ListBox x:Name="ResultsList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                   Foreground="#D5E4EF" Margin="4" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
            <!-- Панель запуска всегда тёмная: выделение и наведение — тёмные в любой теме, иначе белый текст не читается в светлой. -->
            <ListBox.Resources>
              <SolidColorBrush x:Key="SelectedBrush" Color="#21504B"/>
              <SolidColorBrush x:Key="HoverSoftBrush" Color="#18303F"/>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="4,6">
                  <Border x:Name="Badge" DockPanel.Dock="Left" Width="64" CornerRadius="3" Padding="4,2" Margin="0,0,10,0"
                          Background="#3D9B7A" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"
                               FontSize="11" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E8F1F7"/>
                    <TextBlock Text="{Binding Preview}" Foreground="#8EB8B0" FontSize="11.5" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="FAIL">
                    <Setter TargetName="Badge" Property="Background" Value="#C45C5C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="WARN">
                    <Setter TargetName="Badge" Property="Background" Value="#C4852C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="SKIP">
                    <Setter TargetName="Badge" Property="Background" Value="#5A7A8C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="DRY-RUN">
                    <Setter TargetName="Badge" Property="Background" Value="#5A7A8C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="INFO">
                    <Setter TargetName="Badge" Property="Background" Value="#3D6B9B"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="RUN">
                    <Setter TargetName="Badge" Property="Background" Value="#1A9B8E"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#1E3348"/>
          <DockPanel Grid.Row="3">
            <DockPanel DockPanel.Dock="Top" Margin="12,8,12,0">
              <Button DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource Btn}" Height="26" MinWidth="110"
                      Command="{Binding CopyDetailCommand}"/>
              <Button DockPanel.Dock="Right" Content="{Binding DetailViewText}" Style="{StaticResource Btn}" Height="26" MinWidth="80" Margin="0,0,6,0"
                      Command="{Binding ToggleDetailViewCommand}" ToolTip="Таблица или исходный текст"
                      Visibility="{Binding HasDetailAudit, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="Детали" Foreground="#7EB8AE" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
              <TextBox x:Name="DetailBox" Style="{StaticResource LogBox}" BorderThickness="0"
                       IsReadOnly="True" Text="{Binding Detail, Mode=OneWay}"/>
              <!-- Аудит пользователей: карточки учёток вместо текста -->
              <ScrollViewer Background="#0F1C2B" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding ShowAuditTable, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="10,8,10,10">
                  <TextBlock Text="{Binding DetailAudit.Summary}" Foreground="#8EB8B0" FontSize="12" Margin="2,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding DetailAudit.Users}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#152536" BorderBrush="#1E3348" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                          <StackPanel>
                            <DockPanel>
                              <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Border x:Name="SudoBadge" Background="#1A6B62" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed">
                                  <TextBlock Text="{Binding SudoText}" Foreground="White" FontSize="11"/>
                                </Border>
                                <Border x:Name="LockBadge" Background="#8C3A3A" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed">
                                  <TextBlock Text="{Binding LockText}" Foreground="White" FontSize="11"/>
                                </Border>
                              </WrapPanel>
                              <TextBlock Text="{Binding Login}" FontWeight="SemiBold" FontSize="13" Foreground="#E8F1F7" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Info}" Foreground="#8EB8B0" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Info}"/>
                            <TextBlock x:Name="GroupsLine" Foreground="#8EB8B0" FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap">
                              <Run Text="группы:"/> <Run Text="{Binding Groups, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PasswordText}" Foreground="#8EB8B0" FontSize="11.5" Margin="0,1,0,0"/>
                            <TextBlock Text="{Binding KeysTitle}" Foreground="#7EB8AE" FontSize="11" Margin="0,6,0,2"/>
                            <ItemsControl ItemsSource="{Binding Keys}" Visibility="{Binding HasReadableKeys, Converter={StaticResource BoolVis}}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="#0F1C2B" CornerRadius="4" Padding="8,4" Margin="0,0,0,3"
                                          ToolTip="{Binding File}">
                                    <DockPanel>
                                      <TextBlock x:Name="KeyType" DockPanel.Dock="Left" Text="{Binding Type}" Foreground="#E2B039" FontSize="11"
                                                 FontWeight="SemiBold" Width="64" VerticalAlignment="Center"/>
                                      <StackPanel>
                                        <TextBlock Text="{Binding Fingerprint}" Foreground="#D5E4EF" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Fingerprint}"/>
                                        <TextBlock x:Name="KeyComment" Text="{Binding Comment}" Foreground="#8EB8B0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                      </StackPanel>
                                    </DockPanel>
                                  </Border>
                                  <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Comment}" Value="">
                                      <Setter TargetName="KeyComment" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Unreadable}" Value="True">
                                      <Setter TargetName="KeyType" Property="Text" Value="?"/>
                                    </DataTrigger>
                                  </DataTemplate.Triggers>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding HasSudo}" Value="True">
                            <Setter TargetName="SudoBadge" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter TargetName="LockBadge" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Groups}" Value="">
                            <Setter TargetName="GroupsLine" Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding DetailAudit.SudoersText}" Foreground="#8EB8B0" FontSize="11.5" Margin="2,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
</UserControl>
