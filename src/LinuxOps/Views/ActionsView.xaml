<UserControl x:Class="LinuxOps.Views.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.95*" MinWidth="420"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.15*" MinWidth="280"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.2*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Surface}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Хосты" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Опросить" Style="{StaticResource Btn}" Height="28" MinWidth="88"
                        Padding="10,0" Margin="8,0,10,0" ToolTip="SSH: определить дистрибутив и статус"
                        Command="{Binding ProbeCommand}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Text="{Binding HostsSelectedText}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Добавить пользователя" Style="{StaticResource Btn}" Height="28" Padding="10,0"
                        Command="{Binding AddUserCommand}"/>
                <Button Content="{Binding BaseUsersText}" Style="{StaticResource Btn}" Height="28" Margin="8,0,0,0" Padding="10,0"
                        Command="{Binding OpenBaseUsersCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <CheckBox x:Name="SelectAllHosts" Content="Выбрать все / снять все"
                      IsChecked="{Binding SelectAllChecked, Mode=OneWay}" Click="SelectAllHosts_Click"/>
          </Border>
          <ListBox x:Name="HostsList" ItemsSource="{Binding Hosts}" BorderThickness="0" Margin="14,10,14,8" SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseDoubleClick="HostsList_DoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- Макет: [✓] [лого] имя/IP …… ● Online [тег] -->
                <Border Padding="12,11" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                             />
                    <Grid Grid.Column="1" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                          ToolTip="{Binding DistroBadge}">
                      <Ellipse Fill="{Binding DistroColorBrush}"/>
                      <TextBlock Text="{Binding DistroLetter}" Foreground="White" FontWeight="Bold" FontSize="13"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="2" MinWidth="120" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Host}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Ellipse Grid.Column="3" x:Name="StatusDot" Width="8" Height="8"
                             Fill="{DynamicResource UnknownBrush}" VerticalAlignment="Center"
                             ToolTip="{Binding Status}" Margin="10,0,0,0"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="Online">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OnlineBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource WarnBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Offline">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OfflineBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="2" Style="{StaticResource Surface}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
            <TextBlock Text="Каталог действий" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          </Border>
          <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource ToolbarWellBrush}">
            <DockPanel>
              <Button Content="Новое" Style="{StaticResource Btn}" Height="28" MinWidth="72" Padding="10,0" Command="{Binding AddCommand}"/>
              <TextBlock Text="Щелчок — одно действие, Ctrl или Shift — несколько, двойной — изменить, правая кнопка — меню"
                         Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="12,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ActionsList" ItemsSource="{Binding Actions}" Margin="16,12,16,14" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Рамка и фон — только «в плане». Выделения карточек нет. -->
                  <Border x:Name="CardChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                          CornerRadius="10" Padding="2" Margin="0,0,0,8" SnapsToDevicePixels="True" Cursor="Hand"
                          PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown">
                    <Border.ContextMenu>
                      <ContextMenu Opened="CardMenu_Opened">
                        <MenuItem Header="Изменить" FontWeight="SemiBold" Click="CardEdit_Click"/>
                        <MenuItem Header="Клонировать" Click="CardClone_Click"/>
                        <Separator/>
                        <MenuItem Header="Удалить" Click="CardRemove_Click"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" HorizontalAlignment="Stretch">
                      <DockPanel LastChildFill="True">
                        <CheckBox DockPanel.Dock="Left" Content="В плане" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top" Margin="0,2,10,0"
                                  Checked="PlanCheck_Changed" Unchecked="PlanCheck_Changed"/>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                          <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource AccentDeepBrush}"/>
                          </Border>
                          <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Opacity="0.35">
                            <Button Style="{StaticResource BtnIcon}" Width="28" Height="26" MinWidth="0" Margin="0,0,4,0"
                                    Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                    ToolTip="Изменить (двойной щелчок)" Click="CardEdit_Click"/>
                            <Button Style="{StaticResource BtnIcon}" Width="28" Height="26" MinWidth="0" Margin="0,0,4,0"
                                    Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                    ToolTip="Клонировать — копия, которую можно править" Click="CardClone_Click"/>
                            <Button x:Name="RemoveBtn" Style="{StaticResource BtnIcon}" Width="28" Height="26" MinWidth="0" Margin="0"
                                    Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                    ToolTip="Удалить своё действие" Click="CardRemove_Click"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"
                                     FontSize="12" Margin="0,3,0,6" TextWrapping="Wrap"/>
                          <ItemsControl ItemsSource="{Binding DistroTags}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,6,4">
                                  <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource ChipTextBrush}"/>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="CardChrome" Property="IsMouseOver" Value="True">
                      <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource HoverSoftBrush}"/>
                      <Setter TargetName="Tools" Property="Opacity" Value="1"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Definition.BuiltIn}" Value="True">
                      <Setter TargetName="RemoveBtn" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="4" Style="{StaticResource Surface}" Background="#0F1C2B" BorderBrush="#1E3348">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.55*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="0.45*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#152536" Padding="12,10" BorderBrush="#1E3348" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="Запуск плана" Foreground="#D5E4EF" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Right" Foreground="#7EB8AE" FontSize="12" Text="{Binding RunStatus}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
            </DockPanel>
          </Border>
          <!-- Идёт запуск: бегущая полоса под заголовком -->
          <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3" IsIndeterminate="True" BorderThickness="0"
                       Background="Transparent" Foreground="{DynamicResource AccentBrush}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <ListBox x:Name="ResultsList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                   Foreground="#D5E4EF" Margin="4" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="4,6">
                  <Border x:Name="Badge" DockPanel.Dock="Left" Width="64" CornerRadius="3" Padding="4,2" Margin="0,0,10,0"
                          Background="#3D9B7A" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"
                               FontSize="11" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E8F1F7"/>
                    <TextBlock Text="{Binding Preview}" Foreground="#8EB8B0" FontSize="11.5" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="FAIL">
                    <Setter TargetName="Badge" Property="Background" Value="#C45C5C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="WARN">
                    <Setter TargetName="Badge" Property="Background" Value="#C4852C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="SKIP">
                    <Setter TargetName="Badge" Property="Background" Value="#5A7A8C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="DRY-RUN">
                    <Setter TargetName="Badge" Property="Background" Value="#5A7A8C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="INFO">
                    <Setter TargetName="Badge" Property="Background" Value="#3D6B9B"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="RUN">
                    <Setter TargetName="Badge" Property="Background" Value="#1A9B8E"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#1E3348"/>
          <DockPanel Grid.Row="3">
            <DockPanel DockPanel.Dock="Top" Margin="12,8,12,0">
              <Button DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource Btn}" Height="26" MinWidth="110"
                      Command="{Binding CopyDetailCommand}"/>
              <TextBlock Text="Детали" Foreground="#7EB8AE" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="DetailBox" Style="{StaticResource LogBox}" BorderThickness="0"
                     IsReadOnly="True" Text="{Binding Detail, Mode=OneWay}"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
</UserControl>
