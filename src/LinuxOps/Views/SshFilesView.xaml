<UserControl x:Class="LinuxOps.Views.SshFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinuxOps.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="NameCell">
      <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                <Setter Property="FontWeight" Value="SemiBold"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSymlink}" Value="True">
                <Setter Property="FontStyle" Value="Italic"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter Property="Opacity" Value="0.6"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="SizeCell">
      <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
    </DataTemplate>
    <DataTemplate x:Key="MonoCell">
      <TextBlock Text="{Binding RightsText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
    </DataTemplate>

    <Style x:Key="FKey" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Margin" Value="6,4,12,4"/>
      <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
    </Style>
  </UserControl.Resources>

    <Grid PreviewKeyDown="PanelSsh_PreviewKeyDown">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Панель инструментов -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"
              Padding="8,6" Margin="0,0,0,8">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource BtnToolbar}" Click="Connect_Click" ToolTip="Подключиться к хосту, выбранному слева">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Подключить" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Click="SshF10_Click" IsEnabled="{Binding Connected}" ToolTip="F10">
              <TextBlock Text="Отключить" VerticalAlignment="Center"/>
            </Button>
            <Border Style="{StaticResource Sep}"/>
            <Button Style="{StaticResource BtnToolbar}" Click="Refresh_Click" ToolTip="Ctrl+R">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Обновить" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Click="SshF9_Click" ToolTip="F9 — терминал на этом хосте в текущей папке">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Терминал здесь" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Border Style="{StaticResource Sep}"/>
            <TextBlock Text="Права:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <ComboBox x:Name="SshPrivCombo" Width="80" Height="28" Margin="0,0,14,0"
                      SelectionChanged="SshPrivCombo_SelectionChanged"
                      ToolTip="sudo — правка, удаление и копирование чужих файлов от root, если своих прав не хватает">
              <ComboBoxItem Content="user" IsSelected="True"/>
              <ComboBoxItem Content="sudo"/>
            </ComboBox>
            <CheckBox Content="Скрытые" VerticalAlignment="Center" IsChecked="{Binding ShowHidden}" ToolTip="Ctrl+H — файлы с точкой и скрытые файлы Windows"/>
          </StackPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnToolbar}" Margin="0" Click="PickEditor_Click"
                  ToolTip="Программа, в которой F4 открывает файлы">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Редактор F4" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </DockPanel>
      </Border>

      <!-- Две панели -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="LocalBorder" Grid.Column="0" Style="{StaticResource Surface}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="Этот компьютер" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Margin="0,0,4,0" Click="LocalUp_Click" ToolTip="Вверх (Backspace)">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Margin="0,0,4,0" Click="LocalHome_Click" ToolTip="Домашняя папка">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <ComboBox DockPanel.Dock="Left" Width="64" Height="28" Margin="0,0,6,0" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"/>
                  <TextBox x:Name="LocalPathBox" Height="28" Padding="6,2" VerticalContentAlignment="Center" Text="{Binding LocalPath, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                           KeyDown="LocalPathBox_KeyDown" ToolTip="Путь. Enter — перейти"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="LocalInfo" DockPanel.Dock="Bottom" Margin="10,4" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
            <ListView x:Name="LocalFilesList" ItemsSource="{Binding LocalFiles}" Style="{StaticResource FileList}" Margin="2,0,2,0"
                      SelectionMode="Extended" AllowDrop="True" Tag="local"
                      MouseDoubleClick="LocalFiles_DoubleClick" GotKeyboardFocus="LocalFilesList_GotFocus"
                      PreviewMouseDown="LocalFilesList_GotFocus" SelectionChanged="Files_SelectionChanged"
                      PreviewMouseLeftButtonDown="Drag_Down" PreviewMouseMove="LocalDrag_Move"
                      DragOver="Local_DragOver" Drop="Local_Drop"
                      GridViewColumnHeader.Click="Header_Click">
              <ListView.ContextMenu>
                <ContextMenu Tag="local">
                  <MenuItem Header="Открыть" InputGestureText="Enter" Click="MenuOpen_Click" FontWeight="SemiBold"/>
                  <MenuItem Header="Правка" InputGestureText="F4" Click="SshF4_Click"/>
                  <MenuItem Header="Просмотр" InputGestureText="F3" Click="SshF3_Click"/>
                  <Separator/>
                  <MenuItem Header="Загрузить на сервер" InputGestureText="F5" Click="SshF5_Click"/>
                  <MenuItem Header="Переименовать" InputGestureText="F2" Click="SshF6_Click"/>
                  <MenuItem Header="Удалить в корзину" InputGestureText="Del" Click="SshF8_Click"/>
                  <Separator/>
                  <MenuItem Header="Новая папка" InputGestureText="F7" Click="SshF7_Click"/>
                  <MenuItem Header="Новый файл" InputGestureText="Shift+F4" Click="NewFile_Click"/>
                  <Separator/>
                  <MenuItem Header="Копировать путь" Click="CopyPath_Click"/>
                  <MenuItem Header="Показать в проводнике" InputGestureText="Alt+Enter" Click="Properties_Click"/>
                  <MenuItem Header="Обновить" InputGestureText="Ctrl+R" Click="Refresh_Click"/>
                </ContextMenu>
              </ListView.ContextMenu>
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="28" CellTemplate="{StaticResource FileIconTemplate}"/>
                  <GridViewColumn Width="240" CellTemplate="{StaticResource NameCell}">
                    <GridViewColumnHeader Content="Имя" Tag="Name"/>
                  </GridViewColumn>
                  <GridViewColumn Width="80" CellTemplate="{StaticResource SizeCell}">
                    <GridViewColumnHeader Content="Размер" Tag="Size"/>
                  </GridViewColumn>
                  <GridViewColumn Width="120" DisplayMemberBinding="{Binding ModifiedText}">
                    <GridViewColumnHeader Content="Изменён" Tag="Modified"/>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border x:Name="RemoteBorder" Grid.Column="2" Style="{StaticResource Surface}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="{Binding RemoteTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                <DockPanel LastChildFill="True" IsEnabled="{Binding Connected}">
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteBack_Click" ToolTip="Назад (Alt+←)" Margin="0,0,4,0">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteForward_Click" ToolTip="Вперёд (Alt+→)" Margin="0,0,4,0">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteUp_Click" ToolTip="Вверх (Backspace)" Margin="0,0,4,0">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteHome_Click" ToolTip="Домашняя папка (~)" Margin="0,0,4,0">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteRoot_Click" ToolTip="Корень (/)" Margin="0,0,6,0">
                    <TextBlock Text="/" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"/>
                  </Button>
                  <TextBox x:Name="RemotePathBox" Height="28" Padding="6,2" VerticalContentAlignment="Center" Text="{Binding RemotePath, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                           KeyDown="RemotePathBox_KeyDown" ToolTip="Путь. Enter — перейти, ~ — домашняя папка"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="RemoteInfo" DockPanel.Dock="Bottom" Margin="10,4" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
            <Grid>
              <ListView x:Name="RemoteFilesList" ItemsSource="{Binding RemoteFiles}" Style="{StaticResource FileList}" Margin="2,0,2,0"
                        SelectionMode="Extended" AllowDrop="True" Tag="remote"
                        MouseDoubleClick="RemoteFiles_DoubleClick" GotKeyboardFocus="RemoteFilesList_GotFocus"
                        PreviewMouseDown="RemoteFilesList_GotFocus" SelectionChanged="Files_SelectionChanged"
                        PreviewMouseLeftButtonDown="Drag_Down" PreviewMouseMove="RemoteDrag_Move"
                        DragOver="Remote_DragOver" Drop="Remote_Drop"
                        GridViewColumnHeader.Click="Header_Click">
                <ListView.ContextMenu>
                  <ContextMenu Tag="remote">
                    <MenuItem Header="Открыть / править" InputGestureText="Enter" Click="MenuOpen_Click" FontWeight="SemiBold"/>
                    <MenuItem Header="Просмотр" InputGestureText="F3" Click="SshF3_Click"/>
                    <Separator/>
                    <MenuItem Header="Скачать на компьютер" InputGestureText="F5" Click="SshF5_Click"/>
                    <MenuItem Header="Переименовать / перенести" InputGestureText="F2" Click="SshF6_Click"/>
                    <MenuItem Header="Удалить" InputGestureText="Del" Click="SshF8_Click"/>
                    <Separator/>
                    <MenuItem Header="Новая папка" InputGestureText="F7" Click="SshF7_Click"/>
                    <MenuItem Header="Новый файл" InputGestureText="Shift+F4" Click="NewFile_Click"/>
                    <Separator/>
                    <MenuItem Header="Свойства и права…" InputGestureText="Alt+Enter" Click="Properties_Click"/>
                    <MenuItem Header="Копировать путь" Click="CopyPath_Click"/>
                    <MenuItem Header="Терминал в этой папке" InputGestureText="F9" Click="SshF9_Click"/>
                    <MenuItem Header="Обновить" InputGestureText="Ctrl+R" Click="Refresh_Click"/>
                  </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                  <GridView>
                    <GridViewColumn Width="28" CellTemplate="{StaticResource FileIconTemplate}"/>
                    <GridViewColumn Width="210" CellTemplate="{StaticResource NameCell}">
                      <GridViewColumnHeader Content="Имя" Tag="Name"/>
                    </GridViewColumn>
                    <GridViewColumn Width="72" CellTemplate="{StaticResource SizeCell}">
                      <GridViewColumnHeader Content="Размер" Tag="Size"/>
                    </GridViewColumn>
                    <GridViewColumn Width="116" DisplayMemberBinding="{Binding ModifiedText}">
                      <GridViewColumnHeader Content="Изменён" Tag="Modified"/>
                    </GridViewColumn>
                    <GridViewColumn Width="92" CellTemplate="{StaticResource MonoCell}">
                      <GridViewColumnHeader Content="Права" Tag="Rights"/>
                    </GridViewColumn>
                    <GridViewColumn Width="110" DisplayMemberBinding="{Binding OwnerText}">
                      <GridViewColumnHeader Content="Владелец" Tag="Owner"/>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
              <StackPanel x:Name="RemotePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="Не подключено" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Дважды щёлкните хост слева" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Открытые правки F4 -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding OpenEdits}" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Закрыть" Style="{StaticResource Btn}" Height="26" MinWidth="70" Click="CloseEdit_Click"/>
                <Button DockPanel.Dock="Right" Content="Сохранить" Style="{StaticResource Btn}" Height="26" MinWidth="80" Margin="0,0,6,0" Click="SaveEdit_Click"
                        ToolTip="Загрузить на сервер сейчас"/>
                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AccentDeepBrush}"/>
                <TextBlock Text="{Binding State}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,12,0"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Строка состояния и прогресс -->
      <DockPanel Grid.Row="3" Margin="2,4,2,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Transferring, Converter={StaticResource BoolVis}}">
          <ProgressBar Width="200" Height="10" Minimum="0" Maximum="100" Value="{Binding TransferPercent}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>
          <Button Content="Отмена" Style="{StaticResource Btn}" Height="24" MinWidth="70" Margin="8,0,0,0" Click="CancelTransfer_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding TransferStatus}" Margin="12,0,8,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource AccentDeepBrush}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding LastOperation}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>

      <!-- Клавиши как в Far / Total Commander -->
      <UniformGrid x:Name="FnKeys" Grid.Row="4" Columns="9" Margin="0,6,0,0">
        <Button x:Name="KeyF1" Content="F1 Помощь" Style="{StaticResource FKey}" Click="SshF1_Click"/>
        <Button x:Name="KeyF3" Content="F3 Просмотр" Style="{StaticResource FKey}" Click="SshF3_Click"/>
        <Button x:Name="KeyF4" Content="F4 Правка" Style="{StaticResource FKey}" Click="SshF4_Click"/>
        <Button x:Name="KeyF5" Content="F5 Копировать" Style="{StaticResource FKey}" Click="SshF5_Click"/>
        <Button x:Name="KeyF6" Content="F6 Переименовать" Style="{StaticResource FKey}" Click="SshF6_Click"/>
        <Button x:Name="KeyF7" Content="F7 Папка" Style="{StaticResource FKey}" Click="SshF7_Click"/>
        <Button x:Name="KeyF8" Content="F8 Удалить" Style="{StaticResource FKey}" Click="SshF8_Click"/>
        <Button x:Name="KeyF9" Content="F9 Терминал" Style="{StaticResource FKey}" Click="SshF9_Click"/>
        <Button x:Name="KeyF10" Content="F10 Отключить" Style="{StaticResource FKey}" Click="SshF10_Click"/>
      </UniformGrid>
    </Grid>
</UserControl>
