<UserControl x:Class="LinuxOps.Views.SshFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,8" Background="#F3F5F4"
          PreviewKeyDown="PanelSsh_PreviewKeyDown">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="1.2*"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="1*"/>
      </Grid.RowDefinitions>

      <!-- тулбар как на mockup-ssh -->
      <Border Grid.Row="0" Background="#FDFDFD" BorderBrush="#D5DBD8" BorderThickness="1" CornerRadius="4"
              Padding="10,8" Margin="0,0,0,8">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource BtnToolbar}" Click="SshConnect_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Connect" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Click="SshUpload_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Upload" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Click="SshDownload_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Download" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Click="SshDelete_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Delete" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Click="SshTermFocus_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Terminal" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnToolbar}" Margin="0" Click="SshRefresh_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Privilege:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#3A4A45"/>
            <ComboBox x:Name="SshPrivCombo" Width="88" Height="28" Margin="0,0,14,0"
                      SelectionChanged="SshPrivCombo_SelectionChanged">
              <ComboBoxItem Content="user" IsSelected="True"/>
              <ComboBoxItem Content="sudo"/>
            </ComboBox>
            <TextBlock Text="Хост:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#3A4A45"/>
            <ComboBox x:Name="SshHostCombo" Width="240" Height="28" DisplayMemberPath="Display" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                      />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Surface}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="Локально" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="LocalUp_Click" ToolTip="Вверх">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <ComboBox DockPanel.Dock="Left" x:Name="LocalDriveCombo" Width="72" Height="28" Margin="0,0,8,0" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                            />
                  <TextBox x:Name="LocalPathBox" Height="28" Padding="8,2" Text="{Binding LocalPath, Mode=OneWay}"
                           LostFocus="LocalPathBox_LostFocus" KeyDown="LocalPathBox_KeyDown"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <ListView x:Name="LocalFilesList" ItemsSource="{Binding LocalFiles}" Style="{StaticResource FileList}" Margin="4,0,4,4"
                      SelectionMode="Extended" AllowDrop="True"
                      MouseDoubleClick="LocalFiles_DoubleClick" GotFocus="LocalFilesList_GotFocus"
                      PreviewMouseDown="LocalFilesList_GotFocus"
                      PreviewMouseLeftButtonDown="LocalDrag_Down" PreviewMouseMove="LocalDrag_Move"
                      DragOver="Local_DragOver" Drop="Local_Drop">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="" Width="28" CellTemplate="{StaticResource FileIconTemplate}"/>
                  <GridViewColumn Header="Name" Width="220">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="FontWeight" Value="Normal"/>
                              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Size" Width="78" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="Modified" Width="118" DisplayMemberBinding="{Binding ModifiedText}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Column="2" Style="{StaticResource Surface}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="Удалённо" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteBack_Click" ToolTip="Назад" Margin="0,0,4,0">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteForward_Click" ToolTip="Вперёд" Margin="0,0,4,0">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <Button DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Click="RemoteUp_Click" ToolTip="Вверх" Margin="0,0,4,0">
                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                  <TextBox x:Name="RemotePathBox" Height="28" Padding="8,2" Text="{Binding RemotePath, Mode=OneWay}"
                           KeyDown="RemotePathBox_KeyDown" ToolTip="Путь. Enter — перейти"/>
                </DockPanel>
                <TextBlock Text="{Binding TransferStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border>
            <ListView x:Name="RemoteFilesList" ItemsSource="{Binding RemoteFiles}" Style="{StaticResource FileList}" Margin="4,0,4,4"
                      SelectionMode="Extended" AllowDrop="True"
                      MouseDoubleClick="RemoteFiles_DoubleClick" GotFocus="RemoteFilesList_GotFocus"
                      PreviewMouseDown="RemoteFilesList_GotFocus"
                      PreviewMouseLeftButtonDown="RemoteDrag_Down" PreviewMouseMove="RemoteDrag_Move"
                      DragOver="Remote_DragOver" Drop="Remote_Drop">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="" Width="28" CellTemplate="{StaticResource FileIconTemplate}"/>
                  <GridViewColumn Header="Name" Width="220">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="FontWeight" Value="Normal"/>
                              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Size" Width="78" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="Modified" Width="118" DisplayMemberBinding="{Binding ModifiedText}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Row="3" Background="{StaticResource ConsoleBrush}" BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Padding="10,8" Background="{StaticResource ConsoleBrush}" BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
              <TextBlock x:Name="SshTermPrompt" Text="{Binding TermPrompt}" Foreground="{StaticResource ConsoleTextBrush}" VerticalAlignment="Center"
                         Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}"/>
              <Button DockPanel.Dock="Right" Content="&#xE751;" FontFamily="Segoe MDL2 Assets" Width="32" Height="26" Margin="8,0,0,0"
                      Background="{StaticResource ConsoleBorderBrush}" Foreground="{StaticResource ConsoleTextBrush}" BorderBrush="{StaticResource ConsoleBorderBrush}" Click="SshTermRun_Click"/>
              <TextBox x:Name="SshTermInput" Height="26" VerticalContentAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" Padding="8,2"
                       Background="{StaticResource ConsoleBrush}" Foreground="{StaticResource ConsoleTextBrush}" BorderBrush="{StaticResource ConsoleBorderBrush}" CaretBrush="{StaticResource ConsoleTextBrush}"
                       KeyDown="SshTermInput_KeyDown"/>
            </DockPanel>
          </Border>
          <TextBox x:Name="SshTermOut" Style="{StaticResource LogBox}"
                   Text="Connect — remote /etc и ls в терминал."/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="SshTermHostLabel" Text="{Binding TermHostLabel}" Grid.Row="3" Visibility="Collapsed"/>
    </Grid>
</UserControl>
