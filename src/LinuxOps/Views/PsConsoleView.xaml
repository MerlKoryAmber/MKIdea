<UserControl x:Class="LinuxOps.Views.PsConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinuxOps.Views">
  <!-- Консоль PowerShell как терминал VS Code: приглашение идёт сразу за выводом, отдельных полей ввода нет. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <views:TerminalCanvas x:Name="Out" FontFamily="{StaticResource MonoFont}" FontSize="13"
                          Background="{DynamicResource ConsoleBrush}" Foreground="{DynamicResource ConsoleTextBrush}"
                          SelectionBrush="{DynamicResource TermSelectionBrush}" SizeChanged="Out_SizeChanged">
      <views:TerminalCanvas.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="Copy_Click"/>
          <MenuItem Header="Вставить" InputGestureText="Ctrl+V" Click="Paste_Click"/>
          <Separator/>
          <MenuItem Header="Очистить" Click="Clear_Click"/>
        </ContextMenu>
      </views:TerminalCanvas.ContextMenu>
    </views:TerminalCanvas>
    <ScrollBar x:Name="OutBar" Grid.Column="1" Orientation="Vertical" Visibility="Collapsed"/>
    <!-- Подсказки по мере набора, как в терминале VS Code: список у курсора, ↑↓ — выбор, Tab (или Enter после ↑↓) — вставить, Esc — закрыть.
         Фокус остаётся в консоли: список и пункты его не берут. -->
    <Popup x:Name="Suggest" PlacementTarget="{Binding ElementName=Out}" Placement="Bottom" StaysOpen="True"
           AllowsTransparency="True" Focusable="False">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="3" Padding="0,2" Focusable="False">
        <StackPanel Width="440" Focusable="False">
          <ListBox x:Name="SuggestList" MaxHeight="264" Focusable="False" BorderThickness="0"
                   Background="Transparent" Foreground="{DynamicResource TextBrush}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="SuggestList_SelectionChanged" PreviewMouseLeftButtonUp="SuggestList_Click">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="4,1"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <TextBlock x:Name="SuggestTip" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="64"
                     Margin="8,3,8,3" FontSize="11" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
