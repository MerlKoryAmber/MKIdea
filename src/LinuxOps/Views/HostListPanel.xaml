<UserControl x:Class="LinuxOps.Views.HostListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Surface}">
    <DockPanel>
      <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}" Padding="10,8">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Хосты" Style="{StaticResource SectionTitle}"/>
          </DockPanel>
          <Grid>
            <TextBox x:Name="Search" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                     TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
            <TextBlock x:Name="SearchHint" Text="Поиск: имя, адрес, пользователь" Margin="9,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock DockPanel.Dock="Bottom" Margin="10,6" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource MutedBrush}" Text="Двойной щелчок или Enter — открыть. Уже открытый хост — перейти на его вкладку."/>
      <Grid>
        <ListBox x:Name="List" BorderThickness="0" Background="{DynamicResource SurfaceBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="List_SelectionChanged"
                 MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_PreviewKeyDown">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="MenuConnect" Header="Подключить" Click="MenuConnect_Click" FontWeight="SemiBold"/>
              <MenuItem x:Name="MenuNew" Header="Новая вкладка с этим хостом" Click="MenuNew_Click"/>
              <MenuItem x:Name="MenuOther" Header="Открыть" Click="MenuOther_Click"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="8,5" ToolTip="{Binding Display}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Ellipse Fill="{Binding DistroColorBrush}"/>
                  <TextBlock Text="{Binding DistroLetter}" Foreground="White" FontWeight="Bold" FontSize="11"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                         Fill="{Binding StatusColor}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
