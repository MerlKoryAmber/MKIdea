<UserControl x:Class="LinuxOps.Views.FilesTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinuxOps.Views"
             PreviewKeyDown="Root_PreviewKeyDown">
  <Grid Margin="12,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" MinWidth="170"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <views:HostListPanel x:Name="HostsPanel" Grid.Column="0"/>
    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <views:SessionTabStrip x:Name="Strip" Grid.Row="0"/>
      <Grid x:Name="Pages" Grid.Row="1"/>
    </Grid>
  </Grid>
</UserControl>
