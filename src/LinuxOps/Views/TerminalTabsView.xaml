<UserControl x:Class="LinuxOps.Views.TerminalTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinuxOps.Views"
             PreviewKeyDown="Root_PreviewKeyDown">
  <Grid Margin="12,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" MinWidth="180"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <views:HostListPanel x:Name="HostsPanel" Grid.Column="0"/>
    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <views:SessionTabStrip x:Name="Strip" Grid.Row="0"/>
      <Grid x:Name="Pages" Grid.Row="1"/>
      <Border x:Name="Empty" Grid.Row="1" Background="{DynamicResource ConsoleBrush}" CornerRadius="4">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Дважды щёлкните хост слева" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource ConsoleTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="Каждый хост — своя вкладка. Ещё одна сессия к тому же хосту — меню хоста или +." Margin="0,6,0,0"
                     Foreground="#8FA3B5" HorizontalAlignment="Center"/>
          <TextBlock Text="Ctrl+Tab — следующая вкладка, Ctrl+Shift+W — закрыть" Margin="0,4,0,0"
                     Foreground="#8FA3B5" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
