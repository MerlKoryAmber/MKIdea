<UserControl x:Class="LinuxOps.Views.ResourceTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LinuxOps.ViewModels"
             xmlns:local="clr-namespace:LinuxOps.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- Треугольник раскрытия папки -->
    <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="18" Height="22">
              <Path x:Name="Arrow" Data="M0,0 L5,4.5 L0,9 Z" Fill="{DynamicResource MutedBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform x:Name="Rot" Angle="0"/>
                </Path.RenderTransform>
              </Path>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NodeStyle" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="4" Padding="2,2,4,2" SnapsToDevicePixels="True">
                <DockPanel>
                  <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource ExpanderToggle}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
                </DockPanel>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
      <DockPanel MinHeight="26" Background="Transparent" ToolTip="{Binding Title}">
        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                  Focusable="False"
                  Visibility="{Binding ShowChecks, RelativeSource={RelativeSource AncestorType=local:ResourceTree}, Converter={StaticResource BoolVis}}"/>
        <!-- Папка: задник + лицевая сторона, цвет акцента темы -->
        <Grid DockPanel.Dock="Left" Width="20" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
          <Path Data="M0,2 Q0,0 2,0 L7,0 L9,2.5 L18,2.5 Q20,2.5 20,4.5 L20,14 Q20,16 18,16 L2,16 Q0,16 0,14 Z"
                Fill="{DynamicResource AccentDeepBrush}"/>
          <Path Data="M0,6 Q0,4.5 1.5,4.5 L18.5,4.5 Q20,4.5 20,6 L20,14 Q20,16 18,16 L2,16 Q0,16 0,14 Z"
                Fill="{DynamicResource AccentBrush}"/>
        </Grid>
        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                   VerticalAlignment="Center" Margin="8,0,2,0"/>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type vm:ItemNode}">
      <DockPanel Background="Transparent" ToolTip="{Binding Item.Display}">
        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Item.IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                  Focusable="False"
                  Visibility="{Binding ShowChecks, RelativeSource={RelativeSource AncestorType=local:ResourceTree}, Converter={StaticResource BoolVis}}"/>
        <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Item.IconTip}">
          <Ellipse Fill="{Binding Item.IconBrush}"/>
          <TextBlock Text="{Binding Item.IconLetter}" Foreground="White" FontWeight="Bold" FontSize="11"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,2,0" VerticalAlignment="Center"
                 Fill="{Binding Item.StatusColor}" ToolTip="{Binding Item.Status}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Item.Subtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <TreeView x:Name="Tree" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Padding="4"
              ItemContainerStyle="{StaticResource NodeStyle}" AllowDrop="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              AutomationProperties.AutomationId="ResTree"
              SelectedItemChanged="Tree_SelectedItemChanged"
              MouseDoubleClick="Tree_MouseDoubleClick"
              PreviewKeyDown="Tree_PreviewKeyDown"
              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
              PreviewMouseMove="Tree_PreviewMouseMove"
              DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop">
      <TreeView.Resources>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource NodeStyle}"/>
      </TreeView.Resources>
    </TreeView>
    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="12" TextWrapping="Wrap" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
               IsHitTestVisible="False"/>
  </Grid>
</UserControl>
