<UserControl x:Class="LinuxOps.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinuxOps.Views">
    <Grid Margin="24,18">
      <Border Style="{StaticResource Surface}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
            <StackPanel>
              <TextBlock Text="Inventory · хосты и vCenter" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Хосты Linux (SSH) и vCenter (PowerShell-действия) по папкам. Перетаскивайте мышью — ресурсы и папки; щелчок по треугольнику сворачивает папку. Сохраняется в LinuxOps.defaults.json."
                         Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button Content="+ Хост Linux" Style="{StaticResource Btn}" MinWidth="110" Height="30" Margin="0,0,6,4" Padding="10,0"
                        Command="{Binding AddHostCommand}" AutomationProperties.AutomationId="InvAddHost"
                        ToolTip="Новый хост — в выделенную папку"/>
                <Button Content="+ vCenter" Style="{StaticResource Btn}" MinWidth="96" Height="30" Margin="0,0,6,4" Padding="10,0"
                        Command="{Binding AddVCenterCommand}" AutomationProperties.AutomationId="InvAddVc"
                        ToolTip="Новый vCenter — в выделенную папку"/>
                <Button Content="+ Папка" Style="{StaticResource Btn}" MinWidth="90" Height="30" Margin="0,0,16,4" Padding="10,0"
                        Command="{Binding AddFolderCommand}" AutomationProperties.AutomationId="InvAddFolder"
                        ToolTip="Новая папка — внутри выделенной"/>
                <Button Content="Изменить" Style="{StaticResource Btn}" MinWidth="96" Height="30" Margin="0,0,6,4" Padding="10,0"
                        Command="{Binding EditCommand}" AutomationProperties.AutomationId="InvEdit"
                        ToolTip="Ресурс — правка, папка — переименовать (или двойной щелчок по ресурсу)"/>
                <Button Content="Дублировать" Style="{StaticResource Btn}" MinWidth="110" Height="30" Margin="0,0,6,4" Padding="10,0"
                        Command="{Binding DuplicateCommand}"/>
                <Button Content="Удалить" Style="{StaticResource Btn}" MinWidth="96" Height="30" Margin="0,0,6,4" Padding="10,0"
                        Command="{Binding RemoveCommand}" AutomationProperties.AutomationId="InvRemove"
                        ToolTip="Папка удаляется без ресурсов: они переезжают на уровень выше"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <views:ResourceTree x:Name="TreeView" Margin="8"
                              EmptyMessage="Пусто. Добавьте хост Linux или vCenter кнопками выше.">
            <views:ResourceTree.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Новый хост Linux" Command="{Binding AddHostCommand}"/>
                <MenuItem Header="Новый vCenter" Command="{Binding AddVCenterCommand}"/>
                <MenuItem Header="Новая папка" Command="{Binding AddFolderCommand}"/>
                <Separator/>
                <MenuItem Header="Изменить / переименовать" Command="{Binding EditCommand}"/>
                <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="Удалить" Command="{Binding RemoveCommand}"/>
              </ContextMenu>
            </views:ResourceTree.ContextMenu>
          </views:ResourceTree>
        </DockPanel>
      </Border>
    </Grid>
</UserControl>
