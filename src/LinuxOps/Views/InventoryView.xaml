<UserControl x:Class="LinuxOps.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18">
      <Border Style="{StaticResource Surface}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceHeader}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Добавить" Style="{StaticResource Btn}" MinWidth="96" Margin="0,0,6,0" Padding="10,0" Command="{Binding AddCommand}"/>
                <Button Content="Изменить" Style="{StaticResource Btn}" MinWidth="96" Margin="0,0,6,0" Padding="10,0" Command="{Binding EditCommand}"/>
                <Button Content="Дублировать" Style="{StaticResource Btn}" MinWidth="120" Margin="0,0,6,0" Padding="10,0" Command="{Binding DuplicateCommand}"/>
                <Button Content="Удалить" Style="{StaticResource Btn}" MinWidth="96" Padding="10,0" Command="{Binding RemoveCommand}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Inventory · хосты" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Добавление и правка SSH-целей. Сохраняется в LinuxOps.defaults.json."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <DataGrid x:Name="HostsGrid" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost, Mode=TwoWay}" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                    MouseDoubleClick="HostsGrid_DoubleClick"
                    Background="Transparent" BorderThickness="0"
                    RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                    AlternatingRowBackground="{DynamicResource RowAltBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
              <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="120"/>
              <DataGridTextColumn Header="Auth" Binding="{Binding Auth}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
</UserControl>
