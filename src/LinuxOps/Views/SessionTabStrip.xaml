<UserControl x:Class="LinuxOps.Views.SessionTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="Scroll_PreviewMouseWheel">
      <StackPanel Orientation="Horizontal">
        <ItemsControl x:Name="Items" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Chip" Height="32" MaxWidth="240" Margin="0,0,4,0" Padding="10,0,4,0"
                      CornerRadius="6,6,0,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                      Cursor="Hand" ToolTip="{Binding Tip}"
                      MouseLeftButtonDown="Chip_MouseLeftButtonDown" MouseUp="Chip_MouseUp">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Дублировать сессию" Click="Duplicate_Click"/>
                    <Separator/>
                    <MenuItem Header="Закрыть" InputGestureText="Ctrl+Shift+W" Click="Close_Click"/>
                    <MenuItem Header="Закрыть остальные" Click="CloseOthers_Click"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                          Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0" Margin="6,0,0,0"
                          Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}"
                          VerticalAlignment="Center" ToolTip="Закрыть (средняя кнопка мыши)" Click="Close_Click"/>
                  <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{DynamicResource UnknownBrush}"/>
                  <TextBlock x:Name="Caption" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                  <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OnlineBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                  <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverSoftBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="AddBtn" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                Width="30" Height="28" MinWidth="0" MinHeight="0" Padding="0" Margin="2,0,0,2" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}"
                Click="Add_Click"/>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
