<UserControl x:Class="LinuxOps.Views.SshTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Одна сессия терминала. Вкладки и список хостов — в TerminalTabsView. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,8" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="ReconnectBtn" Content="Переподключить" Style="{StaticResource Btn}" Height="28" Margin="0,0,8,0"
                Click="Connect_Click" ToolTip="Подключиться к этому хосту заново"/>
        <Button Content="Отключить" Style="{StaticResource Btn}" Height="28" Margin="0,0,8,0" Click="Disconnect_Click"
                IsEnabled="{Binding Connected}"/>
        <Button Content="SSH Files" Style="{StaticResource Btn}" Height="28" Margin="0,0,8,0" Click="Files_Click"
                ToolTip="Открыть этот хост в SSH Files"/>
        <Button Content="Очистить" Style="{StaticResource Btn}" Height="28" Click="Clear_Click"/>
      </StackPanel>
      <Ellipse Width="9" Height="9" Margin="2,0,8,0" VerticalAlignment="Center">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource UnknownBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Connected}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource OnlineBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Border BorderBrush="{DynamicResource ConsoleBorderBrush}" BorderThickness="1"
              Background="{DynamicResource ConsoleBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <views:TerminalCanvas x:Name="Out" xmlns:views="clr-namespace:LinuxOps.Views"
                                FontFamily="{StaticResource MonoFont}" FontSize="13"
                                Background="{DynamicResource ConsoleBrush}" Foreground="{DynamicResource ConsoleTextBrush}"
                                SelectionBrush="{DynamicResource TermSelectionBrush}"
                                SizeChanged="Out_SizeChanged">
            <views:TerminalCanvas.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Копировать" InputGestureText="Ctrl+Shift+C" Click="Copy_Click"/>
                <MenuItem Header="Вставить" InputGestureText="Ctrl+Shift+V" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
              </ContextMenu>
            </views:TerminalCanvas.ContextMenu>
          </views:TerminalCanvas>
          <ScrollBar x:Name="OutBar" Grid.Column="1" Orientation="Vertical" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <TextBlock x:Name="Placeholder" Text="{Binding Status}" FontSize="15" FontWeight="SemiBold"
                 Foreground="#8FA3B5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
  </Grid>
</UserControl>
