<UserControl x:Class="LinuxOps.Views.SshTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LinuxOps.Views">
  <Grid Margin="12,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" MinWidth="180"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <views:HostListPanel x:Name="HostsPanel" Grid.Column="0"/>
    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,8" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Подключить" Style="{StaticResource Btn}" Height="28" Margin="0,0,8,0" Click="Connect_Click"
                  ToolTip="Подключиться к выбранному хосту"/>
          <Button Content="Отключить" Style="{StaticResource Btn}" Height="28" Margin="0,0,8,0" Click="Disconnect_Click"
                  IsEnabled="{Binding Connected}"/>
          <Button Content="Очистить" Style="{StaticResource Btn}" Height="28" Click="Clear_Click"/>
        </StackPanel>
        <Ellipse Width="9" Height="9" Margin="2,0,8,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource UnknownBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource OnlineBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>

      <Grid Grid.Row="1">
        <TextBox x:Name="Out" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" AcceptsTab="True" IsUndoEnabled="False" Focusable="True"
                 FontFamily="{StaticResource MonoFont}" FontSize="13"
                 Background="{StaticResource ConsoleBrush}" Foreground="{StaticResource ConsoleTextBrush}"
                 BorderBrush="{StaticResource ConsoleBorderBrush}" CaretBrush="{StaticResource ConsoleTextBrush}"
                 SelectionBrush="#3D6A8C"
                 VerticalContentAlignment="Top" Padding="8"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="NoWrap" SizeChanged="Out_SizeChanged">
          <TextBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Копировать" InputGestureText="Ctrl+Shift+C" Click="Copy_Click"/>
              <MenuItem Header="Вставить" InputGestureText="Ctrl+Shift+V" Click="Paste_Click"/>
              <Separator/>
              <MenuItem Header="Очистить" Click="Clear_Click"/>
            </ContextMenu>
          </TextBox.ContextMenu>
        </TextBox>
        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="Дважды щёлкните хост слева" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource ConsoleTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="или выберите его и нажмите Enter" Margin="0,6,0,0"
                     Foreground="#8FA3B5" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
