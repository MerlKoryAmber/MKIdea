@implements IDisposable
@inject WebSession S
@inject IJSRuntime JS
@inject LoginService Login
@inject NavigationManager Nav
@inject WebStore Store
@inject RecordingsKeeper Keeper

<div class="app">
    <header class="header">
        <div class="brand">LinuxOps</div>
        @if (Store.LoadLocalAdmin() is { NoTotp: true, Enabled: true })
        {
            <span class="lab-badge" title="Лабораторный режим: admin / admin без TOTP. Выключить: linuxops-web → Local admin">ЛАБА</span>
        }
        @foreach (var (key, text) in VisibleTabs)
        {
            <button class="chip @(S.Tab == key ? "on" : "")" @onclick="() => Go(key)">@text</button>
        }
        <div class="spacer"></div>
        @if (S.Can(Perm.Settings) && Keeper.Alert() is { Length: > 0 } recAlert)
        {
            <button class="rec-alert" title="@recAlert" @onclick='() => Go("settings")'>⚠<span class="rec-alert-t"> Записи</span></button>
        }
        @if (_canChangePw)
        {
            <button class="user-chip as-button" title="@S.User.RolesText — нажмите, чтобы сменить пароль" @onclick="() => _pwOpen = true"><b>@S.User.Display</b> · @S.User.RolesText</button>
        }
        else
        {
            <span class="user-chip" title="@S.User.RolesText"><b>@S.User.Display</b> · @S.User.RolesText</span>
        }
        <button class="btn-header" title="Выйти" @onclick="Logout">&#x23FB;</button>
        <button class="btn-header @(S.Tab == "settings" ? "on" : "")" title="@(S.Can(Perm.Settings) ? "Настройки: тема, вход, роли" : "Настройки: тема")" @onclick='() => Go("settings")'>&#9881;</button>
        <span class="ver">v@(Version) · web</span>
    </header>

    <main class="body">
        @switch (S.Tab)
        {
            case "inventory": <InventoryTab S="S" />; break;
            case "actions": <ActionsTab S="S" />; break;
            case "history": <HistoryTab S="S" />; break;
            case "fleet": <FleetTab S="S" />; break;
            case "settings": <SettingsTab S="S" />; break;
            case "ssh": <FilesTab S="S" />; break;
            case "terminal": <TerminalTab S="S" />; break;
            case "powershell": <PowerShellTab S="S" />; break;
        }
    </main>

    @if (S.Tab == "actions")
    {
        <footer class="footer">
            <div class="plan-summary">@S.PlanSummary</div>
            <div class="footer-buttons">
                <button class="btn" @onclick="S.ClearResults" disabled="@S.IsRunning">Очистить план</button>
                <button class="btn" style="width:90px" @onclick="S.Cancel" disabled="@(!S.IsRunning)">Стоп</button>
                <button class="btn" style="width:120px" @onclick="() => S.RunPlan(false)" disabled="@(S.IsRunning || !S.Can(Perm.RunCheck))">Dry-run</button>
                <button class="btn primary" style="width:130px" @onclick="() => S.RunPlan(true)" disabled="@(S.IsRunning || !S.Can(Perm.RunApply))">Применить</button>
            </div>
        </footer>
    }

    @if (S.Notice is { } notice && S.Tab != "actions")
    {
        <div class="toast" role="alert" @onclick="S.HideNotice" title="Закрыть">@notice</div>
    }

    <DialogHost S="S" />
    @if (_pwOpen) { <PasswordDialog User="S.User" Ip="@ClientIp" OnClose="() => _pwOpen = false" /> }
    <PromptHost S="S" />
</div>

@code {
    [Parameter] public string ClientIp { get; set; } = "?";
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private static readonly (string Key, string Text)[] Tabs =
    {
        ("inventory", "Inventory"), ("actions", "Actions"), ("fleet", "Vulnerabilities"), ("ssh", "SSH Files"),
        ("terminal", "Connections"), ("powershell", "PowerShell"), ("history", "History")
    };

    private IEnumerable<(string Key, string Text)> VisibleTabs =>
        Tabs.Where(t => S.Can(Perm.HostsView) && t.Key switch
        {
            "ssh" => S.Can(Perm.FilesRead),
            "terminal" => S.Can(Perm.Terminal) || S.Can(Perm.Rdp),
            "powershell" => S.Can(Perm.Vcenter),
            "fleet" => S.Can(Perm.FleetView),
            _ => true
        });

    private static readonly string Version = typeof(WebSession).Assembly.GetName().Version?.ToString(3) ?? "?";

    protected override async Task OnInitializedAsync()
    {
        // кто вошёл — из cookie; роли перечитываются (могли поменять после входа)
        var p = AuthState is null ? null : (await AuthState).User;
        var user = p?.Identity?.IsAuthenticated == true
            ? Login.Resolve(p.Identity.Name ?? "", p.FindFirst("kind")?.Value ?? "", p.FindFirst("display")?.Value ?? "", p.FindAll("grp").Select(c => c.Value))
            : null;
        if (user is null) { Nav.NavigateTo("/login", forceLoad: true); return; }
        S.SetUser(user, ClientIp);
        _canChangePw = Login.CanChangeOwnPassword(user);
        if (!S.Can(Perm.HostsView)) S.Tab = "settings";
        S.Dispatch = a => InvokeAsync(a);
        S.Changed += Redraw;
        S.Dialogs.Changed += Redraw;
        S.Prompts.Changed += Redraw;
        S.Load();
        S.RefreshPreview();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Вкладка переживает F5: хранится в sessionStorage этой вкладки браузера (новое окно — как обычно).
    /// После перезагрузки — вернуть, если она ещё доступна по правам.
    /// </summary>
    private string? _savedTab;

    // смена своего пароля: локальный админ и локальные пользователи с привязанным TOTP
    private bool _canChangePw, _pwOpen;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        try
        {
            if (first)
            {
                var t = await JS.InvokeAsync<string?>("sessionStorage.getItem", "lo.tab");
                _savedTab = t;
                if (t is not null && t != S.Tab && (t == "settings" || VisibleTabs.Any(v => v.Key == t))) { Go(t); StateHasChanged(); return; }
            }
            if (S.Tab != _savedTab)
            {
                _savedTab = S.Tab;
                await JS.InvokeVoidAsync("sessionStorage.setItem", "lo.tab", S.Tab);
            }
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private async Task Logout() => await JS.InvokeVoidAsync("lo.logout");

    private void Go(string tab)
    {
        S.Tab = tab;
        // хосты могли поменять в Inventory другого окна — перечитать (не во время запуска)
        if (tab is "actions" or "inventory" && !S.IsRunning) { S.Load(); if (tab == "actions" && S.Results.All(r => r.Status is "INFO" or "SKIP")) S.RefreshPreview(); }
    }

    public void Dispose()
    {
        S.Changed -= Redraw;
        S.Dialogs.Changed -= Redraw;
        S.Prompts.Changed -= Redraw;
    }
}
