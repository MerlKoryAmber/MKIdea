@* Подключения (Ф3): терминал SSH и RDP через guacd. Сеанс пишется (запись — в History → Сеансы). *@
@inject IJSRuntime JS
@inject LinuxOps.Web.Services.Guac.GuacTickets Tickets
@implements IAsyncDisposable

<div class="page conn-grid">
    <section class="surface">
        <div class="surface-header">
            <div class="row">
                <span class="section-title grow">Хосты</span>
            </div>
            <div class="muted small" style="margin-top:2px">Двойной щелчок — подключиться.</div>
        </div>
        <div class="scroll tree-wrap">
            <HostTree S="S" @bind-Selected="_sel" Activated="Activate" Context="ShowMenu" Empty="Хостов нет." />
        </div>
    </section>

    <section class="surface conn-screen-wrap">
        <div class="surface-header slim">
            <div class="row">
                <span class="section-title grow">@(_title ?? "Сеанс")<span class="muted small" style="margin-left:10px">@_state</span></span>
                <button class="btn sm primary" style="margin-right:6px" @onclick="Connect" disabled="@(!CanConnect)" title="@ConnectHint">Подключиться</button>
                <button class="btn sm" @onclick="Disconnect" disabled="@(_title is null)">Отключить</button>
            </div>
        </div>
        <div class="conn-screen" @onclick="FocusScreen">
            <div class="conn-host" id="@ScreenId"></div>
            @if (_rdpFor is { } rh)
            {
                <div class="conn-empty" @onclick:stopPropagation="true">
                    <form class="rdp-login" @onsubmit="RdpGo" @onsubmit:preventDefault="true">
                        <div class="section-title" style="margin-bottom:4px">RDP: @rh.Config.Title</div>
                        <div class="muted small" style="margin-bottom:10px">Своя доменная учётная запись. Пароль уходит только на этот хост и нигде не сохраняется.</div>
                        <div class="lbl">Учётная запись</div>
                        <input class="input" @bind="_rdpLogin" placeholder="DOMAIN\user или user@domain" autocomplete="username" />
                        <div class="lbl">Пароль</div>
                        <input class="input" type="password" @bind="_rdpPass" autocomplete="current-password" id="rdp-pass" />
                        <div class="row" style="gap:8px;margin-top:12px;justify-content:flex-end">
                            <button type="button" class="btn" style="width:100px" @onclick="CancelRdp">Отмена</button>
                            <button type="submit" class="btn primary" style="width:120px" disabled="@_busy">Войти</button>
                        </div>
                    </form>
                </div>
            }
            else             @if (_title is null)
            {
                <div class="conn-empty"><div>Выберите хост слева и нажмите «Подключиться».</div><div class="small">Сеанс записывается.</div></div>
            }
        </div>
    </section>
</div>

<HostMenu S="S" Here="terminal" Item="@_menu?.Item" X="@(_menu?.X ?? 0)" Y="@(_menu?.Y ?? 0)" OnClose="() => _menu = null" Connect="Connect" />

@code {
    [Parameter, EditorRequired] public WebSession S { get; set; } = null!;

    private (object Item, double X, double Y)? _menu;
    private void ShowMenu((object Item, double X, double Y) m) { if (m.Item is StoredHost) _menu = m; }

    /// <summary>Пришли сюда из меню другой вкладки («Открыть в …») — сразу открыть хост.</summary>
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first || S.OpenHost is not { } h) return;
        S.OpenHost = null;
        _sel = h;
        StateHasChanged();
        await Connect();
        StateHasChanged();
    }

    private const string ScreenId = "guac-terminal";
    private object? _sel;
    private string? _title;
    private string _state = "";
    private bool _busy;
    private IJSObjectReference? _mod;
    private DotNetObjectReference<TerminalTab>? _self;

    private StoredHost? Host => _sel as StoredHost;
    private string? _rdpLogin, _rdpPass;
    private StoredHost? _rdpFor;
    private bool _rdp;
    private DateTime _startedAt;
    private bool _errorShown;

    /// <summary>Ответ guacd — по-русски и с тем, что делать.</summary>
    private static string Explain(string m) => m switch
    {
        _ when m.StartsWith("Authentication failure", StringComparison.OrdinalIgnoreCase) => "RDP: неверная учётная запись или пароль.",
        _ when m.Contains("wrong security type", StringComparison.OrdinalIgnoreCase) => "RDP: пароль принят, но сервер не пустил — у учётной записи нет права входа по RDP на этот хост (или он не принимает NLA).",
        _ when m.StartsWith("Aborted", StringComparison.Ordinal) => "Сеанс прерван шлюзом (ключ хоста, сеть или учётка) — подробности в History → Сеансы.",
        _ when m.Contains("unreachable", StringComparison.OrdinalIgnoreCase) || m.Contains("Upstream", StringComparison.OrdinalIgnoreCase) => "Хост не отвечает — проверьте адрес и порт.",
        _ => "Сеанс: " + m
    };

    private static string Need(StoredHost h) => h.IsWindows ? Perm.Rdp : Perm.Terminal;
    private bool CanConnect => !_busy && Host is { } h && S.CanOn(Need(h), h);
    private string ConnectHint => Host is null ? "Выберите хост"
        : !S.CanOn(Need(Host), Host) ? (Host.IsWindows ? "Нет права «RDP» на этот хост" : "Нет права «Терминал» на этот хост")
        : Host.IsWindows ? "Открыть RDP своей учётной записью" : "Открыть терминал SSH";

    private async Task Activate(object? item)
    {
        _sel = item;
        if (CanConnect) await Connect();
    }

    private async Task Connect()
    {
        if (Host is not { } h) return;
        if (h.IsWindows)
        {
            // RDP: сначала своя учётка — форма поверх экрана
            _rdpFor = h;
            _rdpLogin ??= S.RdpDefaultLogin;
            _rdpPass = "";
            return;
        }
        _busy = true;
        _state = "проверка хоста…";
        StateHasChanged();
        try
        {
            var ticket = await S.OpenTerminal(h, Tickets);
            if (ticket is null) { _state = ""; return; }
            await Start(h, $"{h.Config.Title} — {h.Config.Username}@{h.Config.Host}", ticket);
        }
        finally { _busy = false; }
    }

    private void CancelRdp() { _rdpFor = null; _rdpPass = ""; }

    private async Task RdpGo()
    {
        if (_rdpFor is not { } h) return;
        var ticket = S.OpenRdp(h, _rdpLogin ?? "", _rdpPass ?? "", Tickets);
        _rdpPass = "";
        if (ticket is null) return;
        _rdpFor = null;
        await Start(h, $"{h.Config.Title} — RDP {h.Config.Host}", ticket);
    }

    /// <summary>Открыть экран сеанса по пропуску (SSH и RDP — одинаково).</summary>
    private async Task Start(StoredHost h, string title, string ticket)
    {
        _rdp = h.IsWindows;
        _errorShown = false;
        _startedAt = DateTime.UtcNow;
        _mod ??= await JS.InvokeAsync<IJSObjectReference>("import", WebPaths.Asset("./guac.js"));
        _self ??= DotNetObjectReference.Create(this);
        if (_title is not null) await _mod.InvokeVoidAsync("close", ScreenId);
        _title = title;
        _state = "подключение…";
        StateHasChanged();
        await Task.Yield();
        await _mod.InvokeVoidAsync("open", ScreenId, ticket, _self, h.IsWindows ? "rdp" : "ssh");
    }

    private async Task Disconnect()
    {
        if (_mod is not null) await _mod.InvokeVoidAsync("close", ScreenId);
        _title = null;
        _state = "";
    }

    private async Task FocusScreen()
    {
        if (_mod is not null && _title is not null) await _mod.InvokeVoidAsync("focus", ScreenId);
    }

    [JSInvokable]
    public Task OnGuacState(int st) => InvokeAsync(() =>
    {
        _state = st switch { 1 => "подключение…", 2 => "ожидание…", 3 => "подключено", 4 => "отключение…", 5 => "отключено", _ => _state };
        // guacd не говорит, почему RDP-сервер закрыл сеанс; закрыл сразу — почти всегда учётка или право входа
        if (st == 5 && _rdp && !_errorShown && _title is not null && (DateTime.UtcNow - _startedAt).TotalSeconds < 15)
            S.ShowNotice("RDP: сеанс закрылся сразу. Причины: учётка, право входа по RDP на этот хост или шлюз guacd — подробности в его журнале (linuxops-web logs guacd).");
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnGuacError(string message) => InvokeAsync(() =>
    {
        _state = "ошибка";
        _errorShown = true;
        S.ShowNotice(Explain(message));
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        try { if (_mod is not null) { await _mod.InvokeVoidAsync("close", ScreenId); await _mod.DisposeAsync(); } } catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
