@* Дерево хостов с папками — как ResourceTree настольной версии: в Actions с галками, в Inventory с выделением. *@

@if (!Shown.Any() && S.Folders.Count == 0)
{
    <div class="tree-empty">@Empty</div>
}
else
{
    <div class="tree @(_drag is not null ? "dragging" : "")" data-drop="@(Drop.HasDelegate ? "1" : null)" @ondrop='() => DoDrop("")' @ondragend="EndDrag">
        @Level("", 0)
        @if (_drag is not null)
        {
            <div class="tree-root-drop @(_over == "" ? "drop" : "")" @ondragenter='() => Over("")'>Сюда — в корень</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WebSession S { get; set; } = null!;
    [Parameter] public bool Checks { get; set; }
    /// <summary>Какие хосты показывать (Actions и файлы — только Linux). null — все.</summary>
    [Parameter] public Func<StoredHost, bool>? Filter { get; set; }
    private IEnumerable<StoredHost> Shown => Filter is null ? S.Hosts : S.Hosts.Where(Filter);
    [Parameter] public string Empty { get; set; } = "Хостов нет. Добавьте хосты Linux на вкладке Inventory.";
    /// <summary>Inventory: выделенный хост или папка.</summary>
    [Parameter] public object? Selected { get; set; }
    [Parameter] public EventCallback<object?> SelectedChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<object?> Activated { get; set; }
    /// <summary>Правая кнопка: хост или папка и где открыть меню (координаты окна).</summary>
    [Parameter] public EventCallback<(object Item, double X, double Y)> Context { get; set; }

    /// <summary>Inventory: перетащили хост или папку (0.7.9) — куда (id папки, "" — корень).</summary>
    [Parameter] public EventCallback<(object Item, string FolderId)> Drop { get; set; }
    private object? _drag;
    private string? _over;

    private async Task DoDrop(string folderId)
    {
        var item = _drag;
        EndDrag();
        if (item is null || !Drop.HasDelegate) return;
        if (item is HostFolder f && f.Id == folderId) return; // на саму себя
        await Drop.InvokeAsync((item, folderId));
    }

    // в Actions и Files (без Drop) перетаскивание выделенного текста не должно включать зону «в корень»
    private void StartDrag(object item) { if (Drop.HasDelegate) _drag = item; }
    private void Over(string folderId) { if (_drag is not null) _over = folderId; }
    private void EndDrag() { _drag = null; _over = null; }

    private async Task Menu(object item, MouseEventArgs e)
    {
        if (!Context.HasDelegate) return;
        if (!Checks) await SelectedChanged.InvokeAsync(item);
        await Context.InvokeAsync((item, e.ClientX, e.ClientY));
    }

    private RenderFragment Level(string parent, int depth) => __builder =>
    {
        foreach (var f in S.Folders.Where(f => f.ParentId == parent).OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase))
        {
            var hosts = HostsIn(f.Id).ToList();
            var all = hosts.Count > 0 && hosts.All(h => h.Config.IsSelected);
            var some = hosts.Any(h => h.Config.IsSelected);
            // галка у папки — только если отметили саму папку; отмеченные внутри хосты — «частично» (черта)
            var on = all && S.CheckedFolders.Contains(f.Id);
            <div class="tree-row @(ReferenceEquals(Selected, f) ? "selected" : "") @(_over == f.Id ? "drop" : "")" style="padding-left:@(depth * 19 + 2)px"
                 draggable="@(Drop.HasDelegate ? "true" : "false")" @ondragstart="() => StartDrag(f)" @ondragenter="() => Over(f.Id)"
                 @ondrop="() => DoDrop(f.Id)" @ondrop:stopPropagation="true"
                 @onclick="() => Pick(f)" @ondblclick="() => Activated.InvokeAsync(f)"
                 @oncontextmenu="e => Menu(f, e)" @oncontextmenu:preventDefault="@Context.HasDelegate">
                <span class="tree-toggle" @onclick="() => Toggle(f)" @onclick:stopPropagation="true">@(f.IsExpanded ? "▾" : "▸")</span>
                @if (Checks)
                {
                    @if (some && !on)
                    {
                        <span class="cb-partial" title="Внутри отмечены хосты (@hosts.Count(h => h.Config.IsSelected) из @hosts.Count). Щелчок — отметить всю папку"
                              @onclick="() => CheckFolder(f, true)" @onclick:stopPropagation="true"></span>
                    }
                    else
                    {
                        <input type="checkbox" checked="@on" title="Отметить все хосты папки"
                               @onclick:stopPropagation="true" @onchange="e => CheckFolder(f, (bool)e.Value!)" />
                    }
                }
                <svg class="folder-icon" width="20" height="16" viewBox="0 0 20 16">
                    <path d="M0,2 Q0,0 2,0 L7,0 L9,2.5 L18,2.5 Q20,2.5 20,4.5 L20,14 Q20,16 18,16 L2,16 Q0,16 0,14 Z" class="f-back" />
                    <path d="M0,6 Q0,4.5 1.5,4.5 L18.5,4.5 Q20,4.5 20,6 L20,14 Q20,16 18,16 L2,16 Q0,16 0,14 Z" class="f-front" />
                </svg>
                <span class="tree-title">@f.Name</span>
                <span class="tree-count">@hosts.Count</span>
            </div>
            if (f.IsExpanded)
            {
                @Level(f.Id, depth + 1)
            }
        }
        foreach (var h in Shown.Where(h => FolderOf(h) == parent))
        {
            var c = h.Config;
            <div class="tree-row host @(ReferenceEquals(Selected, h) ? "selected" : "")" style="padding-left:@(depth * 19 + 20)px"
                 draggable="@(Drop.HasDelegate ? "true" : "false")" @ondragstart="() => StartDrag(h)" @ondragenter="() => Over(FolderOf(h))"
                 @ondrop="() => DoDrop(FolderOf(h))" @ondrop:stopPropagation="true" title="@(h.IsWindows ? c.Title + " · RDP " + c.Host : c.Display)"
                 @onclick="() => Pick(h)" @ondblclick="() => Activated.InvokeAsync(h)"
                 @oncontextmenu="e => Menu(h, e)" @oncontextmenu:preventDefault="@Context.HasDelegate">
                @if (Checks)
                {
                    <input type="checkbox" checked="@c.IsSelected" @onclick:stopPropagation="true"
                           @onchange="e => CheckHost(h, (bool)e.Value!)" />
                }
                @if (h.IsWindows)
                {
                    <span class="distro" style="background:#0078D4" title="Windows · RDP">W</span>
                }
                else
                {
                    <span class="distro" style="background:@c.IconColor" title="@c.IconTip">@c.IconLetter</span>
                }
                <span class="tree-text">
                    <span class="tree-title">@c.Title</span>
                    <span class="tree-sub">@(h.IsWindows ? "RDP · " + c.Host + (c.Port is > 0 and not 3389 ? ":" + c.Port : "") : c.Subtitle)</span>
                </span>
                <span class="dot" style="background:@c.StatusColor" title="@c.Status"></span>
            </div>
        }
    };

    /// <summary>Папка хоста; несуществующая — корень.</summary>
    private string FolderOf(StoredHost h) =>
        h.Config.FolderId.Length > 0 && S.Folders.Any(f => f.Id == h.Config.FolderId) ? h.Config.FolderId : "";

    private IEnumerable<StoredHost> HostsIn(string folderId)
    {
        foreach (var h in Shown.Where(h => FolderOf(h) == folderId)) yield return h;
        foreach (var sub in S.Folders.Where(f => f.ParentId == folderId))
            foreach (var h in HostsIn(sub.Id)) yield return h;
    }

    private async Task Pick(object item)
    {
        if (Checks)
        {
            if (item is StoredHost h) await CheckHost(h, !h.Config.IsSelected);
            return;
        }
        await SelectedChanged.InvokeAsync(item);
    }

    private void Toggle(HostFolder f) => S.ToggleFolder(f);

    private async Task CheckHost(StoredHost h, bool on)
    {
        h.Config.IsSelected = on;
        // сняли хост — снять отметку с папок над ним
        if (!on)
            for (var p = FolderOf(h); p.Length > 0; p = S.Folders.FirstOrDefault(f => f.Id == p)?.ParentId ?? "")
                S.CheckedFolders.Remove(p);
        await Changed.InvokeAsync();
    }

    private async Task CheckFolder(HostFolder f, bool on)
    {
        foreach (var h in HostsIn(f.Id)) h.Config.IsSelected = on;
        foreach (var sub in SubFolders(f.Id).Append(f.Id))
            if (on) S.CheckedFolders.Add(sub); else S.CheckedFolders.Remove(sub);
        if (!on)
            for (var p = f.ParentId; p.Length > 0; p = S.Folders.FirstOrDefault(x => x.Id == p)?.ParentId ?? "")
                S.CheckedFolders.Remove(p);
        await Changed.InvokeAsync();
    }

    private IEnumerable<string> SubFolders(string id)
    {
        foreach (var sub in S.Folders.Where(x => x.ParentId == id))
        {
            yield return sub.Id;
            foreach (var s in SubFolders(sub.Id)) yield return s;
        }
    }
}
