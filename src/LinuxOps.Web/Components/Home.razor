@page "/"

<Shell @rendermode="Mode" ClientIp="@Ip" />

@code {
    private static readonly IComponentRenderMode Mode = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>На стенде без входа «кто» в аудите — адрес клиента.</summary>
    private string Ip => HttpContext?.Connection.RemoteIpAddress is { } a
        ? (a.IsIPv4MappedToIPv6 ? a.MapToIPv4().ToString() : a.ToString())
        : "?";
}
