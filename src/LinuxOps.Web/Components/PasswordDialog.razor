@* Смена своего пароля (0.7.3): локальный админ и локальные пользователи. Текущий пароль + новый + код TOTP. *@
@inject LoginService Login

<div class="overlay">
    <form class="window" @onsubmit="Save" @onsubmit:preventDefault="true">
        <div class="window-title">Сменить пароль — @User.Login</div>
        <div class="window-body">
            @if (_done)
            {
                <div class="message">Пароль сменён. В следующий раз входите с новым паролем.</div>
            }
            else
            {
                <div class="form-grid">
                    <label>Текущий</label><input class="input" type="password" @bind="_current" autocomplete="current-password" id="pw-current" />
                    <label>Новый</label><input class="input" type="password" @bind="_next" autocomplete="new-password" placeholder="не короче @LocalUser.MinPassword символов" />
                    <label>Повтор</label><input class="input" type="password" @bind="_repeat" autocomplete="new-password" />
                    <label>Код TOTP</label><input class="input" @bind="_code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" style="width:110px" />
                </div>
                @if (_error.Length > 0) { <div class="error small">@_error</div> }
            }
        </div>
        <div class="window-buttons">
            @if (_done)
            {
                <button type="button" class="btn primary" style="width:100px" @onclick="Close">OK</button>
            }
            else
            {
                <button type="button" class="btn" style="width:100px" @onclick="Close">Отмена</button>
                <button type="submit" class="btn primary" style="width:140px" disabled="@_busy">Сменить</button>
            }
        </div>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public UserInfo User { get; set; } = null!;
    [Parameter, EditorRequired] public string Ip { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private string _current = "", _next = "", _repeat = "", _code = "", _error = "";
    private bool _busy, _done;

    private async Task Save()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            // хэш пароля — тяжёлый, не в потоке отрисовки
            var err = await Task.Run(() => Login.ChangeOwnPassword(User, _current, _next, _repeat, _code.Trim(), Ip));
            _current = _code = "";
            if (err is null) { _next = _repeat = ""; _done = true; }
            else _error = err;
        }
        finally { _busy = false; }
    }

    private Task Close() => OnClose.InvokeAsync();
}
