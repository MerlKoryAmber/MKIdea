@inject IJSRuntime JS

<div class="page actions-grid">
    @* ---------- хосты ---------- *@
    <section class="surface">
        <div class="surface-header">
            <div class="row">
                <span class="section-title grow">Хосты и vCenter</span>
                <button class="btn sm" style="margin:0 10px 0 8px" title="Хосты — SSH: дистрибутив и статус" @onclick="Probe" disabled="@(_probing || !S.Can(Perm.RunCheck))">Опросить</button>
                <span class="muted small">@S.HostsSelectedText</span>
            </div>
            <div class="wrap" style="margin-top:8px">
                <button class="btn sm" @onclick="AddUser" disabled="@(S.IsRunning || !S.Can(Perm.RunApply))">Добавить пользователя</button>
                <button class="btn sm" @onclick="CloseAccess" disabled="@(S.IsRunning || !S.Can(Perm.RunApply) || !S.SelectedHosts.Any())"
                        title="Заблокировать, отозвать ключ или удалить учётку на отмеченных хостах; там же — «Открыть доступ»">Закрыть доступ</button>
                <button class="btn sm" @onclick="BaseUsers" disabled="@(S.IsRunning || !S.Can(Perm.RunApply))"
                        title="Список учёток, которые ставятся на отмеченные хосты одной кнопкой">Базовые пользователи (@_baseCount)</button>
            </div>
        </div>
        <div class="scroll tree-wrap">
            <HostTree S="S" Checks="true" Filter="h => !h.IsWindows" Changed="Changed" Empty="Ресурсов нет. Добавьте хосты Linux на вкладке Inventory." />
        </div>
        <div class="surface-footer">
            <label class="check"><input type="checkbox" checked="@AllChecked" @onchange="e => SelectAll((bool)e.Value!)" /> Выбрать все / снять все</label>
        </div>
    </section>

    @* ---------- каталог ---------- *@
    <section class="surface">
        <div class="surface-header slim">
            <div class="row">
                <span class="section-title grow" title="Щелчок — в план или из плана">Каталог действий</span>
                <button class="btn sm" style="min-width:72px" @onclick="NewAction" disabled="@(!S.CanEditActions)" title="@S.EditActionsHint">Новое</button>
            </div>
        </div>
        <div class="scroll cards">
            @foreach (var a in S.Actions)
            {
                <div class="card-chrome @(a.IsSelected ? "planned" : "")" @onclick="() => Toggle(a)"
                     @oncontextmenu="e => ShowCardMenu(e, a)" @oncontextmenu:preventDefault="true">
                    <div class="card">
                        <input type="checkbox" checked="@a.IsSelected" title="В плане" @onclick:stopPropagation="true" @onchange="() => Toggle(a)" />
                        <div class="card-body">
                            <div class="card-title">@a.Title</div>
                            <div class="card-desc">@a.Description</div>
                            <div class="tags">
                                @foreach (var t in a.DistroTags)
                                {
                                    <span class="tag">@t</span>
                                }
                            </div>
                        </div>
                        <div class="card-side">
                            <span class="badge">@a.Badge</span>
                            @if (a.Definition.ReadOnly) { <span class="badge" style="margin-top:4px" title="Только получает информацию; доступно через API">чтение</span> }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    @* ---------- запуск плана (всегда тёмная) ---------- *@
    <section class="surface run">
        <div class="run-header">
            <span class="run-title">Запуск плана</span>
            <span class="run-status" title="@S.RunStatus">@S.RunStatus</span>
            @if (S.IsRunning)
            {
                <div class="progress"></div>
            }
        </div>
        <div class="results scroll">
            @foreach (var r in S.Results)
            {
                <div class="result @(ReferenceEquals(r, S.Selected) ? "selected" : "")" @onclick="() => S.UserSelect(r)">
                    <span class="status st-@r.Status.ToLowerInvariant()">@r.Status</span>
                    <div class="result-text">
                        <div class="result-title">@r.Title</div>
                        <div class="result-preview">@r.Preview</div>
                    </div>
                </div>
            }
        </div>
        <div class="run-split"></div>
        <div class="detail">
            <div class="detail-bar">
                <span class="detail-label">Детали</span>
                <span class="grow"></span>
                @if (S.HasTable)
                {
                    <button class="btn sm dark" style="min-width:80px" title="Таблица или исходный текст" @onclick="() => S.ShowRawDetail = !S.ShowRawDetail">@(S.ShowRawDetail ? "Таблица" : "Текст")</button>
                }
                <button class="btn sm dark" style="min-width:110px" @onclick="Copy">@_copyText</button>
            </div>
            <DetailView S="S" />
        </div>
    </section>
</div>

@if (_cardMenu is { } cm)
{
    <div class="ctx-overlay" @onclick="() => _cardMenu = null" @oncontextmenu="() => _cardMenu = null" @oncontextmenu:preventDefault="true"></div>
    <div class="ctx-menu" style="left:min(@Px(cm.X)px, calc(100vw - 210px));top:min(@Px(cm.Y)px, calc(100vh - 140px))">
        @if (!cm.A.Definition.BuiltIn)
        {
            <button @onclick="() => CardDo(() => EditAction(cm.A, clone: false))" disabled="@(!S.CanEditActions)" title="@S.EditActionsHint">Изменить</button>
        }
        <button @onclick="() => CardDo(() => EditAction(cm.A, clone: true))" disabled="@(!S.CanEditActions)" title="@S.EditActionsHint">Дублировать</button>
        @if (!cm.A.Definition.BuiltIn)
        {
            <hr />
            <button @onclick="() => CardDo(() => DeleteAction(cm.A))" disabled="@(!S.CanEditActions)" title="@S.EditActionsHint">Удалить</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WebSession S { get; set; } = null!;

    private bool _probing;
    private string _copyText = "Копировать";
    private (ActionItemView A, double X, double Y)? _cardMenu;

    private static string Px(double v) => Math.Max(4, v).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private void ShowCardMenu(MouseEventArgs e, ActionItemView a) => _cardMenu = (a, e.ClientX, e.ClientY);

    private async Task CardDo(Func<Task> act)
    {
        var item = _cardMenu?.A;
        _cardMenu = null;
        if (item is null) return;
        await act();
    }

    private Task NewAction() => EditAction(null, clone: false);

    private async Task EditAction(ActionItemView? item, bool clone)
    {
        if (!S.CanEditActions)
        {
            await S.Dialogs.Info(S.EditActionsHint, "Свои действия");
            return;
        }

        var d = new UiDialog
        {
            Kind = "action",
            Title = item is null ? "Новое действие" : clone ? "Дублировать действие" : "Изменить действие",
            Action = item?.Definition,
            Values = { ["clone"] = clone ? "1" : "0" }
        };
        if (await S.Dialogs.Show(d) is not ActionDefinition def) return;
        int? prev = null;
        if (d.Values.TryGetValue("prevScriptLen", out var raw) && int.TryParse(raw, out var n))
            prev = n;
        S.SaveCustomAction(def, prev);
    }

    private async Task DeleteAction(ActionItemView item)
    {
        if (!S.CanEditActions)
        {
            await S.Dialogs.Info(S.EditActionsHint, "Свои действия");
            return;
        }
        if (!await S.Dialogs.Confirm($"Удалить «{item.Definition.Name}»?", "Удалить действие")) return;
        S.DeleteCustomAction(item.Definition);
    }

    private bool AllChecked => S.LinuxHosts.Any() && S.LinuxHosts.All(h => h.Config.IsSelected);

    private void Changed()
    {
        S.RefreshPreview();
        S.Notify();
    }

    private void SelectAll(bool on)
    {
        foreach (var h in S.LinuxHosts) h.Config.IsSelected = on;
        S.CheckedFolders.Clear();
        if (on) foreach (var f in S.Folders) S.CheckedFolders.Add(f.Id);
        Changed();
    }

    private void Toggle(ActionItemView a)
    {
        a.IsSelected = !a.IsSelected;
        Changed();
    }

    private async Task Probe()
    {
        _probing = true;
        try { await S.Probe(); }
        finally { _probing = false; }
        S.RefreshPreview();
    }

    private async Task AddUser()
    {
        var hosts = S.SelectedHosts.ToList();
        var d = new UiDialog { Kind = "adduser", Title = "Добавить пользователя", Hosts = hosts.Select(h => h.Config).ToList() };
        if (await S.Dialogs.Show(d) is not AddUserRequest req) return;
        await S.AddUser(req, hosts);
    }

    private async Task CloseAccess()
    {
        var hosts = S.SelectedHosts.ToList();
        var d = new UiDialog { Kind = "access", Title = "Закрыть доступ", Targets = hosts };
        if (await S.Dialogs.Show(d) is not AccessDialog.Go go) return;
        await S.CloseAccess(go.Request, go.Targets);
        _baseCount = S.BaseUsersCount; // «Закрыть доступ» мог выключить запись
    }

    private int _baseCount;
    protected override void OnInitialized() => _baseCount = S.BaseUsersCount;

    private async Task BaseUsers()
    {
        var hosts = S.SelectedHosts.ToList();
        var d = new UiDialog { Kind = "baseusers", Title = "Базовые пользователи", Targets = hosts };
        var r = await S.Dialogs.Show(d);
        _baseCount = S.BaseUsersCount;
        if (r is BaseUsersDialog.ApplyThese go) await S.ApplyBaseUsers(go.Logins, hosts);
    }

    private async Task Copy()
    {
        var text = S.Detail;
        if (text.Length == 0) return;
        try
        {
            await JS.InvokeVoidAsync("lo.copy", text);
            _copyText = "Скопировано";
        }
        catch
        {
            _copyText = "Не удалось";
        }
        StateHasChanged();
        await Task.Delay(1500);
        _copyText = "Копировать";
    }
}
