@* Inventory → правая кнопка → «Доступ…»: назначения на папку или хост — свои и унаследованные (от папок выше и «на всё»). *@
@inject WebStore Store
@inject AuditLog Audit

<div class="overlay" @onclick="Close" @onkeydown="Key" tabindex="-1">
    <div class="window access-window" @onclick:stopPropagation="true">
        <div class="window-title">Доступ: @(Item is HostFolder ? "📁" : "🖥") @ItemPath</div>
        <div class="window-body">
            <div class="muted small" style="margin-bottom:8px">
                @(Item is HostFolder ? "Назначение на папку действует на её хосты и вложенные папки." : "Назначение только на этот хост.")
                Изменения — сразу; у вошедших — после обновления страницы.
            </div>
            <table class="grid">
                <thead><tr><th>Кто</th><th>Роль</th><th>Права</th><th style="width:170px">Откуда</th><th style="width:32px"></th></tr></thead>
                <tbody>
                @foreach (var (a, from) in Effective())
                {
                    var role = _roles.FirstOrDefault(r => r.Id == a.RoleId);
                    <tr>
                        <td title="@a.KindText">@a.Icon @a.Who</td>
                        <td>@(role?.Name ?? "?")</td>
                        <td class="small">@(role is null ? "" : string.Join(", ", role.Perms.Select(Perm.Short)))</td>
                        <td class="small @(from is null ? "" : "muted")">@(from ?? "здесь")</td>
                        <td>
                            @if (from is null)
                            {
                                <button class="btn-icon" title="Убрать назначение" @onclick="() => Remove(a)">×</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Effective().Any())
                {
                    <tr><td colspan="5" class="muted">Никому, кроме локального админа.</td></tr>
                }
                </tbody>
            </table>

            <div class="section-title" style="margin-top:14px">Назначить</div>
            @if (_who is null)
            {
                <WhoPicker OnPick="w => _who = w" />
            }
            else
            {
                <div class="wrap">
                    <span class="chip-x">@_who.Icon @_who.Who <button title="Другой" @onclick="() => _who = null">×</button></span>
                    <span style="margin:0 6px">роль:</span>
                    <select class="input" style="width:auto" @bind="_roleId">
                        @foreach (var r in _roles) { <option value="@r.Id">@r.Name — @string.Join(", ", r.Perms.Select(Perm.Short))</option> }
                    </select>
                    <button class="btn primary" style="margin-left:8px" @onclick="Add">Назначить</button>
                </div>
            }
            @if (_msg.Length > 0) { <div class="muted small" style="margin-top:8px">@_msg</div> }
        </div>
        <div class="window-buttons">
            <button class="btn" style="width:100px" @onclick="Close">Закрыть</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public WebSession S { get; set; } = null!;
    /// <summary>HostFolder или StoredHost.</summary>
    [Parameter, EditorRequired] public object Item { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private List<Role> _roles = new();
    private List<Assignment> _all = new();
    private List<HostFolder> _folders = new();
    private WhoPicker.Picked? _who;
    private string _roleId = "operator", _msg = "";

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _roles = Store.LoadRoles();
        _all = Store.LoadAssignments();
        _folders = Store.LoadFolders();
    }

    private string Id => Item switch { HostFolder f => f.Id, StoredHost h => h.Id, _ => "" };
    private string ScopeKind => Item is HostFolder ? Scope.Folder : Scope.Host;
    private string ParentFolder => Item switch { HostFolder f => f.ParentId, StoredHost h => h.Config.FolderId, _ => "" };

    private string ItemPath => Item switch
    {
        HostFolder f => FolderPath(f.Id),
        StoredHost h => (h.Config.FolderId.Length > 0 ? FolderPath(h.Config.FolderId) + " / " : "") + h.Config.Title,
        _ => ""
    };

    private string FolderPath(string id)
    {
        var parts = new List<string>();
        for (var f = _folders.FirstOrDefault(x => x.Id == id); f is not null; f = _folders.FirstOrDefault(x => x.Id == f.ParentId))
            parts.Insert(0, f.Name);
        return string.Join(" / ", parts);
    }

    /// <summary>Назначения, которые действуют на объект: свои (from = null), от папок выше, «на всё».</summary>
    private IEnumerable<(Assignment A, string? From)> Effective()
    {
        foreach (var a in _all.Where(a => a.Scope == ScopeKind && a.ObjectId == Id)) yield return (a, null);
        for (var p = ParentFolder; p.Length > 0; p = _folders.FirstOrDefault(x => x.Id == p)?.ParentId ?? "")
            foreach (var a in _all.Where(a => a.Scope == Scope.Folder && a.ObjectId == p)) yield return (a, $"от «{FolderPath(p)}»");
        foreach (var a in _all.Where(a => a.Scope == Scope.All)) yield return (a, "на всё");
    }

    private void Remove(Assignment a)
    {
        if (!S.Can(Perm.Settings)) return;
        Store.DeleteAssignment(a.Id);
        var role = _roles.FirstOrDefault(r => r.Id == a.RoleId)?.Name ?? a.RoleId;
        Audit.Write(S.Who, "доступ: снят", $"{a.KindText} {a.Who}, роль «{role}» → {ItemPath}");
        _msg = $"{a.Who}: «{role}» на «{ItemPath}» снята.";
        Reload();
    }

    private void Add()
    {
        if (!S.Can(Perm.Settings) || _who is null) return;
        var role = _roles.FirstOrDefault(r => r.Id == _roleId);
        if (role is null) return;
        var w = _who;
        if (_all.Any(a => a.Scope == ScopeKind && a.ObjectId == Id && a.RoleId == role.Id && a.Local == w.Local && a.IsGroup == w.IsGroup
                          && string.Equals(a.Who, w.Who, StringComparison.OrdinalIgnoreCase)))
        {
            _msg = "Такое назначение уже есть.";
            return;
        }
        Store.SaveAssignment(new Assignment { Who = w.Who, IsGroup = w.IsGroup, Local = w.Local, RoleId = role.Id, Scope = ScopeKind, ObjectId = Id });
        Audit.Write(S.Who, "доступ: выдан", $"{w.KindText} {w.Who}, роль «{role.Name}» → {ItemPath}");
        _msg = $"{w.Who}: «{role.Name}» на «{ItemPath}».";
        _who = null;
        Reload();
    }

    private Task Key(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    private Task Close() => OnClose.InvokeAsync();
}
