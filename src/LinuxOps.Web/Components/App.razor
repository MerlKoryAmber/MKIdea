<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>LinuxOps</title>
    <link rel="stylesheet" href="app.css" />
    <script>
        // тема: light / dark / system — как в настольной версии; выбор помнит браузер
        (function () {
            var t = 'system';
            try { t = localStorage.getItem('lo-theme') || 'system'; } catch (e) { }
            document.documentElement.dataset.theme = t;
        })();
        window.lo = {
            theme: function () { return document.documentElement.dataset.theme || 'system'; },
            setTheme: function (t) {
                document.documentElement.dataset.theme = t;
                try { localStorage.setItem('lo-theme', t); } catch (e) { }
            },
            copy: function (text) { return navigator.clipboard ? navigator.clipboard.writeText(text) : null; },
            logout: function () { document.getElementById("lo-logout")?.submit(); }
        };
        // Сессия: есть движение мыши / клавиши — раз в минуту продлить (/auth/ping); простой дольше IdleMinutes — на вход.
        (function () {
            var last = Date.now(), pinged = Date.now();
            ["mousemove", "keydown", "mousedown", "wheel", "touchstart"].forEach(function (e) {
                window.addEventListener(e, function () { last = Date.now(); }, { passive: true });
            });
            setInterval(function () {
                var el = document.getElementById("lo-idle");
                if (!el) return;
                var idleMs = (parseInt(el.dataset.min, 10) || 30) * 60000;
                if (Date.now() - last > idleMs) { location.href = "/login"; return; }
                if (last > pinged) {
                    pinged = Date.now();
                    fetch("/auth/ping", { credentials: "same-origin", redirect: "manual" }).then(function (r) {
                        if (r.type === "opaqueredirect" || r.status === 401) location.href = "/login";
                    }).catch(function () { });
                }
            }, 60000);
        })();
    </script>
</head>
<body>
    <Routes />
    @* Своя плашка вместо серого окна Blazor «Could not reconnect»: обрыв (перезапуск или обновление службы, сеть) —
       тонкая полоска сверху, страница остаётся видна; как только сервис отвечает — страница перезагружается сама. *@
    <div id="components-reconnect-modal" class="lo-reconnect">Связь с сервером потеряна — переподключаюсь…</div>
    <script>
        (function () {
            var el = document.getElementById("components-reconnect-modal"), polling = false;
            function reloadWhenUp() {
                if (polling) return;
                polling = true;
                el.textContent = "Сервис перезапускается — страница обновится сама…";
                (function poll() {
                    fetch("/auth/ping", { credentials: "same-origin", redirect: "manual", cache: "no-store" })
                        .then(function (r) { if (r.status < 500 || r.type === "opaqueredirect") location.reload(); else setTimeout(poll, 2000); })
                        .catch(function () { setTimeout(poll, 2000); });
                })();
            }
            new MutationObserver(function () {
                var c = el.className;
                // rejected — сервер жив, но окна уже не помнит (служба перезапускалась); failed — попытки кончились
                if (c.indexOf("components-reconnect-rejected") >= 0 || c.indexOf("components-reconnect-failed") >= 0) reloadWhenUp();
            }).observe(el, { attributes: true, attributeFilter: ["class"] });
        })();
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

