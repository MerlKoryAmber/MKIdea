<div class="page single">
    <section class="surface">
        <div class="surface-header">
            <div class="section-title">Inventory · хосты и vCenter</div>
            <div class="muted small" style="margin:2px 0 8px">Хосты Linux (SSH) и Windows (RDP) по папкам. Пароли и ключи — в хранилище сервиса (зашифрованы), в браузер не возвращаются. Щелчок по треугольнику сворачивает папку, правая кнопка — меню (правка, «Переместить в папку…», «Доступ…»); хост и папку можно перетащить мышью на папку.</div>
            <div class="wrap">
                <button class="btn" style="min-width:110px" title="Новый хост — в выделенную папку" @onclick="AddHost" disabled="@(!CanAdd)">+ Хост Linux</button>
                <button class="btn" style="min-width:120px" title="Хост Windows (RDP) — в выделенную папку" @onclick="AddWinHost" disabled="@(!CanAdd)">+ Хост Windows</button>
                <button class="btn" style="min-width:96px" disabled title="Профили vCenter в вебе пока нет: PowerCLI — во вкладке PowerShell (Connect-VIServer)">+ vCenter</button>
                <button class="btn" style="min-width:90px;margin-right:16px" title="Новая папка — внутри выделенной" @onclick="AddFolder" disabled="@(!CanAdd)">+ Папка</button>
                <button class="btn" style="min-width:96px" title="Хост — правка, папка — переименовать (или двойной щелчок)" @onclick="Edit" disabled="@(!CanEdit(_sel))">Изменить</button>
                <button class="btn" style="min-width:110px" @onclick="Duplicate" disabled="@(_sel is not StoredHost || !CanAdd)">Дублировать</button>
                <button class="btn" style="min-width:96px;margin-right:16px" title="Папка удаляется без хостов: они переезжают на уровень выше" @onclick="Remove" disabled="@(!CanDelete(_sel))">Удалить</button>
                <button class="btn" style="min-width:96px" title="Хосты списком из CSV: шаблон — в окне импорта" @onclick="() => _import = true" disabled="@Ro">Импорт…</button>
                <button class="btn" style="min-width:120px" title="Логин и ключ или пароль сразу на несколько хостов Linux (выделенная папка — все её хосты)" @onclick="() => _creds = true" disabled="@Ro">Учётка SSH…</button>
            </div>
        </div>
        <div class="scroll tree-wrap" style="margin:8px">
            <HostTree S="S" @bind-Selected="_sel" Activated="Open" Drop="@(Ro ? default : EventCallback.Factory.Create<(object Item, string FolderId)>(this, OnDrop))" Context="@(Ro && !S.Can(Perm.Settings) ? default : EventCallback.Factory.Create<(object Item, double X, double Y)>(this, ShowMenu))" Empty="Пусто. Добавьте хост кнопкой выше." />
        </div>
    </section>
</div>

@if (_menu is { } m)
{
    <div class="ctx-overlay" @onclick="() => _menu = null" @oncontextmenu="() => _menu = null" @oncontextmenu:preventDefault="true"></div>
    <div class="ctx-menu" style="left:min(@Px(m.X)px, calc(100vw - 210px));top:min(@Px(m.Y)px, calc(100vh - 262px))">
        <button @onclick="() => Do(Edit)" disabled="@(!CanEdit(m.Item))">@(m.Item is HostFolder ? "Переименовать" : "Изменить")</button>
        @if (m.Item is StoredHost)
        {
            <button @onclick="() => Do(Duplicate)" disabled="@(!CanAdd)">Дублировать</button>
        }
        else
        {
            <button @onclick="() => Do(AddHost)" disabled="@(!CanAdd)">+ Хост Linux сюда</button>
            <button @onclick="() => Do(AddWinHost)" disabled="@(!CanAdd)">+ Хост Windows сюда</button>
            <button @onclick="() => Do(AddFolder)" disabled="@(!CanAdd)">+ Папка внутри</button>
        }
        <button @onclick="() => Do(OpenMove)" disabled="@(!CanDelete(m.Item))">@MoveText(m.Item)</button>
        <hr />
        <button @onclick="() => Do(OpenAccess)" disabled="@(!S.Can(Perm.Settings))" title="@(S.Can(Perm.Settings) ? "Кто и с какой ролью имеет доступ" : "Нужно право «Настройки»")">Доступ…</button>
        <hr />
        <button @onclick="() => Do(Remove)" disabled="@(!CanDelete(m.Item))">Удалить</button>
    </div>
}

@if (_access is not null)
{
    <AccessPanel S="S" Item="_access" OnClose="() => _access = null" />
}
@if (_move is { } mv)
{
    <MovePanel S="S" Hosts="mv.Hosts" Folder="mv.Folder" OnClose="() => _move = null" />
}
@if (_import)
{
    <ImportPanel S="S" OnClose="() => _import = false" />
}
@if (_creds)
{
    <CredsPanel S="S" Start="_sel" OnClose="() => _creds = false" />
}

@code {
    [Parameter, EditorRequired] public WebSession S { get; set; } = null!;

    private object? _sel;
    private (object Item, double X, double Y)? _menu;
    private object? _access;
    private bool _import, _creds;

    private void ShowMenu((object Item, double X, double Y) m) => _menu = m;

    // у правого и нижнего края меню прижимается внутрь (min() в стиле)
    private static string Px(double v) => Math.Max(4, v).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private async Task Do(Func<Task> act) { _menu = null; await act(); }
    private Task Do(Action act) { _menu = null; act(); return Task.CompletedTask; }

    // ---------- переместить (0.7.9) ----------
    private (IReadOnlyList<StoredHost> Hosts, HostFolder? Folder)? _move;

    /// <summary>Хост среди отмеченных (галки в Actions) — переезжают все отмеченные.</summary>
    private List<StoredHost> MoveSet(StoredHost h)
    {
        var marked = S.Hosts.Where(x => x.Config.IsSelected).ToList();
        return marked.Count > 1 && marked.Contains(h) ? marked : new List<StoredHost> { h };
    }

    private string MoveText(object item) => item is StoredHost h && MoveSet(h) is { Count: > 1 } set
        ? $"Переместить отмеченные ({set.Count})…" : "Переместить в папку…";

    private void OpenMove()
    {
        _move = _sel switch
        {
            StoredHost h => (MoveSet(h), null),
            HostFolder f => (Array.Empty<StoredHost>(), f),
            _ => null
        };
    }

    /// <summary>Перетаскивание в дереве: на папку — внутрь, на хост — в его папку, на пустое место — в корень.</summary>
    private void OnDrop((object Item, string FolderId) d)
    {
        var (ok, text) = d.Item switch
        {
            // мышью — только то, что тянут: галки Actions здесь не видны
            StoredHost h => S.MoveHosts(new[] { h }, d.FolderId),
            HostFolder f => S.MoveFolder(f, d.FolderId),
            _ => (true, "")
        };
        if (!ok) S.ShowNotice(text);
    }

    private void OpenAccess() { if (S.Can(Perm.Settings)) _access = _sel; }

    /// <summary>Нет права «Inventory» нигде — меню и окна правки не нужны.</summary>
    private bool Ro => !S.Can(Perm.HostsEdit);

    // права на конкретный объект (как проверяет сервис): добавить — в папку; изменить — сам объект; удалить папку — её родитель
    private bool CanAdd => S.CanOnFolder(Perm.HostsEdit, TargetFolder);

    private bool CanEdit(object? item) => item switch
    {
        StoredHost h => S.CanOn(Perm.HostsEdit, h),
        HostFolder f => S.CanOnFolder(Perm.HostsEdit, f.Id),
        _ => false
    };

    private bool CanDelete(object? item) => item switch
    {
        StoredHost h => S.CanOn(Perm.HostsEdit, h),
        HostFolder f => S.CanOnFolder(Perm.HostsEdit, f.ParentId),
        _ => false
    };

    private string TargetFolder => _sel switch
    {
        HostFolder f => f.Id,
        StoredHost h => h.Config.FolderId,
        _ => ""
    };

    private Task AddHost() => EditHost(new StoredHost { Config = new HostConfig { FolderId = TargetFolder, IsSelected = false } }, true);
    private Task AddWinHost() => EditHost(new StoredHost { Config = new HostConfig { FolderId = TargetFolder, IsSelected = false, Port = 3389, Username = "", DistroHint = StoredHost.WindowsHint } }, true);

    private async Task Duplicate()
    {
        if (_sel is not StoredHost src) return;
        var c = src.Config;
        var copy = new StoredHost
        {
            Config = new HostConfig
            {
                Name = c.Name + " (копия)", Host = c.Host, Port = c.Port, Username = c.Username, Auth = c.Auth,
                UseSudo = c.UseSudo, FolderId = c.FolderId, DistroHint = c.DistroHint, IsSelected = false
            }
        };
        // пароль и ключ не копируются: у копии свои
        await EditHost(copy, true);
    }

    private async Task EditHost(StoredHost h, bool isNew)
    {
        var d = h.IsWindows ? new UiDialog { Kind = "winhost", Title = "Хост Windows", Host = h } : new UiDialog { Kind = "host", Title = "Хост", Host = h };
        if (await S.Dialogs.Show(d) is not HostEdit e) return;
        var c = h.Config;
        c.Name = e.Config.Name; c.Host = e.Config.Host; c.Port = e.Config.Port; c.Username = e.Config.Username;
        c.Auth = e.Config.Auth; c.UseSudo = e.Config.UseSudo;
        S.SaveHost(h, e.Password, e.Key, e.KeyName);
        _sel = h;
    }

    private async Task AddFolder()
    {
        var f = new HostFolder { ParentId = TargetFolder };
        if (await S.Dialogs.Show(new UiDialog { Kind = "folder", Title = "Новая папка", Folder = f, Values = { ["name"] = "" } }) is not string name) return;
        f.Name = name;
        S.SaveFolder(f);
        _sel = f;
    }

    private Task Edit() => Open(_sel);

    private async Task Open(object? item)
    {
        if (!CanEdit(item)) return; // без права на объект окно правки не открываем — всё равно не сохранить
        switch (item)
        {
            case StoredHost h:
                await EditHost(h, false);
                break;
            case HostFolder f:
                if (await S.Dialogs.Show(new UiDialog { Kind = "folder", Title = "Папка", Folder = f, Values = { ["name"] = f.Name } }) is string name)
                {
                    f.Name = name;
                    S.SaveFolder(f);
                }
                break;
        }
    }

    private async Task Remove()
    {
        switch (_sel)
        {
            case StoredHost h:
                if (!await S.Dialogs.Confirm($"Удалить хост «{h.Config.Title}» вместе с его паролем и ключом в хранилище?")) return;
                S.DeleteHost(h);
                break;
            case HostFolder f:
                if (!await S.Dialogs.Confirm($"Удалить папку «{f.Name}»? Хосты и вложенные папки переедут на уровень выше.")) return;
                S.DeleteFolder(f);
                break;
            default: return;
        }
        _sel = null;
    }
}
