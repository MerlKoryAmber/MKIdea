<div class="page single">
    <section class="surface">
        <div class="surface-header">
            <div class="section-title">Inventory · хосты и vCenter</div>
            <div class="muted small" style="margin:2px 0 8px">Хосты Linux (SSH) по папкам. Пароли и ключи — в хранилище сервиса (зашифрованы), в браузер не возвращаются. Щелчок по треугольнику сворачивает папку, правая кнопка — меню (правка, «Доступ…»).</div>
            <div class="wrap">
                <button class="btn" style="min-width:110px" title="Новый хост — в выделенную папку" @onclick="AddHost" disabled="@Ro">+ Хост Linux</button>
                <button class="btn" style="min-width:120px" disabled title="Хосты Windows (RDP) — этап Ф3, после стенда">+ Хост Windows</button>
                <button class="btn" style="min-width:96px" disabled title="vCenter (PowerShell) — этап Ф5">+ vCenter</button>
                <button class="btn" style="min-width:90px;margin-right:16px" title="Новая папка — внутри выделенной" @onclick="AddFolder" disabled="@Ro">+ Папка</button>
                <button class="btn" style="min-width:96px" title="Хост — правка, папка — переименовать (или двойной щелчок)" @onclick="Edit" disabled="@(Ro || _sel is null)">Изменить</button>
                <button class="btn" style="min-width:110px" @onclick="Duplicate" disabled="@(Ro || _sel is not StoredHost)">Дублировать</button>
                <button class="btn" style="min-width:96px" title="Папка удаляется без хостов: они переезжают на уровень выше" @onclick="Remove" disabled="@(Ro || _sel is null)">Удалить</button>
            </div>
        </div>
        <div class="scroll tree-wrap" style="margin:8px">
            <HostTree S="S" @bind-Selected="_sel" Activated="Open" Context="@(Ro && !S.Can(Perm.Settings) ? default : EventCallback.Factory.Create<(object Item, double X, double Y)>(this, ShowMenu))" Empty="Пусто. Добавьте хост Linux кнопкой выше." />
        </div>
    </section>
</div>

@if (_menu is { } m)
{
    <div class="ctx-overlay" @onclick="() => _menu = null" @oncontextmenu="() => _menu = null" @oncontextmenu:preventDefault="true"></div>
    <div class="ctx-menu" style="left:min(@Px(m.X)px, calc(100vw - 210px));top:min(@Px(m.Y)px, calc(100vh - 230px))">
        <button @onclick="() => Do(Edit)" disabled="@Ro">@(m.Item is HostFolder ? "Переименовать" : "Изменить")</button>
        @if (m.Item is StoredHost)
        {
            <button @onclick="() => Do(Duplicate)" disabled="@Ro">Дублировать</button>
        }
        else
        {
            <button @onclick="() => Do(AddHost)" disabled="@Ro">+ Хост Linux сюда</button>
            <button @onclick="() => Do(AddFolder)" disabled="@Ro">+ Папка внутри</button>
        }
        <hr />
        <button @onclick="() => Do(OpenAccess)" disabled="@(!S.Can(Perm.Settings))" title="@(S.Can(Perm.Settings) ? "Какие роли, группы и люди видят это" : "Нужно право «Настройки»")">Доступ…</button>
        <hr />
        <button @onclick="() => Do(Remove)" disabled="@Ro">Удалить</button>
    </div>
}

@if (_access is not null)
{
    <AccessPanel S="S" Item="_access" OnClose="() => _access = null" />
}

@code {
    [Parameter, EditorRequired] public WebSession S { get; set; } = null!;

    private object? _sel;
    private (object Item, double X, double Y)? _menu;
    private object? _access;

    private void ShowMenu((object Item, double X, double Y) m) => _menu = m;

    // у правого и нижнего края меню прижимается внутрь (min() в стиле)
    private static string Px(double v) => Math.Max(4, v).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private async Task Do(Func<Task> act) { _menu = null; await act(); }
    private Task Do(Action act) { _menu = null; act(); return Task.CompletedTask; }

    private void OpenAccess() { if (S.Can(Perm.Settings)) _access = _sel; }

    /// <summary>Нет права менять Inventory — кнопки выключены (и сервер не даст).</summary>
    private bool Ro => !S.Can(Perm.HostsEdit);

    private string TargetFolder => _sel switch
    {
        HostFolder f => f.Id,
        StoredHost h => h.Config.FolderId,
        _ => ""
    };

    private Task AddHost() => EditHost(new StoredHost { Config = new HostConfig { FolderId = TargetFolder, IsSelected = false } }, true);

    private async Task Duplicate()
    {
        if (_sel is not StoredHost src) return;
        var c = src.Config;
        var copy = new StoredHost
        {
            Config = new HostConfig
            {
                Name = c.Name + " (копия)", Host = c.Host, Port = c.Port, Username = c.Username, Auth = c.Auth,
                UseSudo = c.UseSudo, FolderId = c.FolderId, DistroHint = c.DistroHint, IsSelected = false
            }
        };
        // пароль и ключ не копируются: у копии свои
        await EditHost(copy, true);
    }

    private async Task EditHost(StoredHost h, bool isNew)
    {
        var d = new UiDialog { Kind = "host", Title = "Хост", Host = h };
        if (await S.Dialogs.Show(d) is not HostEdit e) return;
        var c = h.Config;
        c.Name = e.Config.Name; c.Host = e.Config.Host; c.Port = e.Config.Port; c.Username = e.Config.Username;
        c.Auth = e.Config.Auth; c.UseSudo = e.Config.UseSudo;
        S.SaveHost(h, e.Password, e.Key, e.KeyName);
        _sel = h;
    }

    private async Task AddFolder()
    {
        var f = new HostFolder { ParentId = TargetFolder };
        if (await S.Dialogs.Show(new UiDialog { Kind = "folder", Title = "Новая папка", Folder = f, Values = { ["name"] = "" } }) is not string name) return;
        f.Name = name;
        S.SaveFolder(f);
        _sel = f;
    }

    private Task Edit() => Open(_sel);

    private async Task Open(object? item)
    {
        if (Ro) return; // без права «Inventory» окна правки не открываем — всё равно не сохранить
        switch (item)
        {
            case StoredHost h:
                await EditHost(h, false);
                break;
            case HostFolder f:
                if (await S.Dialogs.Show(new UiDialog { Kind = "folder", Title = "Папка", Folder = f, Values = { ["name"] = f.Name } }) is string name)
                {
                    f.Name = name;
                    S.SaveFolder(f);
                }
                break;
        }
    }

    private async Task Remove()
    {
        switch (_sel)
        {
            case StoredHost h:
                if (!await S.Dialogs.Confirm($"Удалить хост «{h.Config.Title}» вместе с его паролем и ключом в хранилище?")) return;
                S.DeleteHost(h);
                break;
            case HostFolder f:
                if (!await S.Dialogs.Confirm($"Удалить папку «{f.Name}»? Хосты и вложенные папки переедут на уровень выше.")) return;
                S.DeleteFolder(f);
                break;
            default: return;
        }
        _sel = null;
    }
}
