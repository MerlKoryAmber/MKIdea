# LinuxOps Web — служба (AlmaLinux 10, без контейнеров).
# Ставится deploy/install.sh; управление — команда linuxops-web (меню). Релизы: /opt/linuxops-web/releases/<ver>, текущий — ссылка current.
# Слушает только 127.0.0.1:5080; наружу — nginx с TLS (deploy/nginx-linuxops-web.conf).
[Unit]
Description=LinuxOps Web
After=network-online.target
Wants=network-online.target

[Service]
User=linuxops-web
WorkingDirectory=/opt/linuxops-web/current
ExecStart=/opt/linuxops-web/current/LinuxOps.Web --urls http://127.0.0.1:5080
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_gcServer=0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# своих устройств службе не нужно: и устройство с подключённого хранилища (NFS, SMB) не откроет
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# записи сеансов: сервис удаляет старые (срок и объём); «-» — каталога может не быть (установка без guacd)
# хранилище записей (SMB, NFS, диск) монтирует помощник root в -/var/lib/linuxops-web-archive; служба переносит туда готовые записи
# /etc/linuxops-web — только чтение (root:служба 0750): мастер-ключ создаёт установщик
ReadWritePaths=/var/lib/linuxops-web -/var/lib/linuxops-web-rec -/var/lib/linuxops-web-ps -/var/lib/linuxops-web-archive

[Install]
WantedBy=multi-user.target
