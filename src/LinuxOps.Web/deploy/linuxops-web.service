# LinuxOps Web — служба (AlmaLinux 10, без контейнеров).
# Ставится deploy/install.sh; управление — команда linuxops-web (меню). Релизы: /opt/linuxops-web/releases/<ver>, текущий — ссылка current.
# Слушает только 127.0.0.1:5080; наружу — nginx с TLS (deploy/nginx-linuxops-web.conf).
[Unit]
Description=LinuxOps Web
After=network-online.target
Wants=network-online.target

[Service]
User=linuxops-web
WorkingDirectory=/opt/linuxops-web/current
ExecStart=/opt/linuxops-web/current/LinuxOps.Web --urls http://127.0.0.1:5080
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_gcServer=0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/linuxops-web /etc/linuxops-web

[Install]
WantedBy=multi-user.target
